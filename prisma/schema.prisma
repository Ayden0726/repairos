generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum ContactRole {
  PRIMARY
  BILLING
  TECHNICAL
  OTHER
}

enum PreferredContact {
  SMS
  EMAIL
  PHONE
}

enum ItemKind {
  REPAIR_PART
  PC_COMPONENT
  ACCESSORY
  REFURBISHED_DEVICE
  SERIALIZED_ASSET
}

enum SerializedStatus {
  IN_STOCK
  RESERVED
  INSTALLED
  SOLD
  RETURNED
  WRITTEN_OFF
  IN_REFURBISHMENT
}

enum ReservationTarget {
  TICKET
  PC_BUILD
  REFURBISHMENT
}

enum PartNeedStatus {
  IN_STOCK
  RESERVED
  NEED_TO_ORDER
  ORDERED
  RECEIVED
  INSTALLED
  RETURNED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  PENDING
  APPROVED
  DECLINED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PART_PAID
  PAID
  REFUNDED
  VOID
}

enum InvoiceLineType {
  PARTS
  LABOUR
  DIAGNOSTIC
  SERVICE
  DISCOUNT
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum GstTreatment {
  INCLUSIVE
  EXCLUSIVE
  GST_FREE
}

enum BookingStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  CONVERTED
  CANCELLED
  NO_SHOW
}

enum PcBuildStatus {
  QUOTE
  AWAITING_APPROVAL
  DEPOSIT_REQUIRED
  PARTS_REQUIRED
  PARTS_ORDERED
  READY_TO_BUILD
  ASSEMBLY
  TESTING
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum UsedDeviceStatus {
  ASSESSED
  PURCHASED
  REFURBISHING
  READY_FOR_SALE
  SOLD
  RETURNED
  WRITTEN_OFF
}

enum ConditionGrade {
  A
  B
  C
  D
  FAULTY
}

enum DiagnosticValue {
  PASS
  FAIL
  NOT_TESTED
  NOT_APPLICABLE
}

enum TimeEntryState {
  RUNNING
  PAUSED
  STOPPED
}

enum SignaturePurpose {
  CHECK_IN
  REPAIR_AUTHORISATION
  QUOTE
  PICKUP
  OTHER
}

enum CustomFieldType {
  TEXT
  LONG_TEXT
  NUMBER
  CURRENCY
  CHECKBOX
  DROPDOWN
  MULTI_SELECT
  DATE
  DATETIME
  FILE
  BOOLEAN
  SERIAL
}

enum CommunicationChannel {
  SMS
  EMAIL
  PHONE_NOTE
  SYSTEM
}

enum CommunicationVisibility {
  CUSTOMER
  INTERNAL
}

enum SlaState {
  NONE
  ON_TRACK
  APPROACHING
  BREACHED
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  REMEDIATED
  CLOSED
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
  VERIFYING
  VERIFIED
}

enum HealthState {
  HEALTHY
  WARNING
  CRITICAL
  UNKNOWN
}

enum ReturnDisposition {
  RETURN_TO_STOCK
  NEEDS_INSPECTION
  WARRANTY_REPAIR
  DAMAGED
  WRITE_OFF
}

enum PcComponentCategory {
  CPU
  GPU
  MOTHERBOARD
  RAM
  SSD
  HDD
  PSU
  CASE
  CPU_COOLER
  FANS
  NETWORKING
  ACCESSORIES
  PERIPHERALS
  OTHER
}

// ---------------------------------------------------------------------------
// Auth / staff
// ---------------------------------------------------------------------------

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String
  phone             String?
  passwordHash      String
  status            UserStatus @default(ACTIVE)
  roleId            String
  role              Role       @relation(fields: [roleId], references: [id])
  isOwner           Boolean    @default(false)
  totpEnabled       Boolean    @default(false)
  totpSecretEnc     String?
  totpConfirmedAt   DateTime?
  mustResetPassword Boolean    @default(false)
  lastLoginAt       DateTime?
  lastLoginIp       String?
  archivedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  sessions          Session[]
  recoveryCodes     RecoveryCode[]
  preferences       UserPreference?
  createdTickets    Ticket[]              @relation("TicketCreatedBy")
  assignedTickets   Ticket[]              @relation("TicketAssignee")
  closedTickets     Ticket[]              @relation("TicketClosedBy")
  notes             TicketNote[]
  timeEntries       TechnicianTimeEntry[]
  notifications     Notification[]
  shifts            RosterShift[]
  auditEvents       AuditEvent[]          @relation("AuditActor")
  signaturesWitness Signature[]           @relation("SignatureStaff")
  knowledgeArticles KnowledgeArticle[]    @relation("ArticleAuthor")
  reportedIncidents SecurityIncident[]    @relation("IncidentReporter")
  assignedBookings  Booking[]             @relation("BookingStaff")
  paymentsRecorded  Payment[]             @relation("PaymentRecordedBy")
  refundsIssued     Refund[]              @relation("RefundIssuedBy")
  stocktakes        Stocktake[]
  importJobs        ImportJob[]
  backupsStarted    BackupRecord[]
  quotesCreated     Quote[]               @relation("QuoteCreatedBy")
  invoicesCreated   Invoice[]             @relation("InvoiceCreatedBy")
  pcBuildsAssigned  PcBuild[]             @relation("PcBuildAssignee")
  communications    Communication[]
  purchaseOrders    PurchaseOrder[]       @relation("PoCreatedBy")

  @@index([roleId])
  @@index([status])
  @@index([archivedAt])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  id         String @id @default(cuid())
  roleId     String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission String

  @@unique([roleId, permission])
  @@index([permission])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String   @unique
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  lastSeenAt       DateTime @default(now())
  ip               String?
  userAgent        String?
  pendingTwoFactor Boolean  @default(false)

  @@index([userId])
  @@index([expiresAt])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model UserPreference {
  id                    String  @id @default(cuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                 String  @default("system")
  defaultTicketView     String  @default("board")
  dashboardConfig       Json?
  tableColumns          Json?
  keyboardShortcutsOn   Boolean @default(true)
  defaultPrinterId      String?
  defaultLabelPrinterId String?
  density               String  @default("comfortable")
}

model Setting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

model PricingGroup {
  id               String     @id @default(cuid())
  name             String
  labourMultiplier Decimal    @default(1) @db.Decimal(6, 3)
  discountPercent  Decimal    @default(0) @db.Decimal(6, 3)
  markupPercent    Decimal    @default(0) @db.Decimal(6, 3)
  isDefault        Boolean    @default(false)
  archivedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  customers        Customer[]
}

model Customer {
  id                    String           @id @default(cuid())
  type                  CustomerType     @default(INDIVIDUAL)
  firstName             String?
  lastName              String?
  displayName           String
  companyName           String?
  phone                 String?
  email                 String?
  billingEmail          String?
  addressLine1          String?
  addressLine2          String?
  suburb                String?
  state                 String?
  postcode              String?
  preferredContact      PreferredContact @default(SMS)
  notes                 String?
  category              String?
  pricingGroupId        String
  pricingGroup          PricingGroup     @relation(fields: [pricingGroupId], references: [id])
  abn                   String?
  purchaseOrderRequired Boolean          @default(false)
  archivedAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  contacts        CustomerContact[]
  devices         CustomerDevice[]
  tickets         Ticket[]
  quotes          Quote[]
  invoices        Invoice[]
  bookings        Booking[]
  pcBuilds        PcBuild[]
  usedPurchases   UsedDevicePurchase[] @relation("UsedSeller")
  communications  Communication[]
  privacyConsents PrivacyConsent[]
  warranties      Warranty[]
  returns         ReturnRecord[]

  @@index([displayName])
  @@index([phone])
  @@index([email])
  @@index([companyName])
  @@index([archivedAt])
  @@index([type])
}

model CustomerContact {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       ContactRole @default(OTHER)
  phone      String?
  email      String?
  isPrimary  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
}

model CustomerDevice {
  id             String       @id @default(cuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  deviceModelId  String?
  deviceModel    DeviceModel? @relation(fields: [deviceModelId], references: [id])
  nickname       String?
  deviceType     String?
  manufacturer   String?
  modelName      String?
  variant        String?
  serial         String?
  imei           String?
  colour         String?
  storage        String?
  specifications Json?
  purchaseDate   DateTime?
  purchasePrice  Decimal?     @db.Decimal(12, 2)
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tickets        Ticket[]
  pcBuilds       PcBuild[]

  @@index([customerId])
  @@index([serial])
  @@index([imei])
  @@index([deviceModelId])
}

// ---------------------------------------------------------------------------
// Device catalogue
// ---------------------------------------------------------------------------

model Manufacturer {
  id         String             @id @default(cuid())
  name       String             @unique
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  families   DeviceFamily[]
  articles   KnowledgeArticle[]
}

model DeviceFamily {
  id             String             @id @default(cuid())
  manufacturerId String
  manufacturer   Manufacturer       @relation(fields: [manufacturerId], references: [id])
  name           String
  deviceClass    String
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  models         DeviceModel[]
  articles       KnowledgeArticle[]

  @@unique([manufacturerId, name])
}

model DeviceModel {
  id                   String              @id @default(cuid())
  familyId             String
  family               DeviceFamily        @relation(fields: [familyId], references: [id])
  name                 String
  year                 Int?
  metadata             Json?
  diagnosticTemplateId String?
  diagnosticTemplate   DiagnosticTemplate? @relation(fields: [diagnosticTemplateId], references: [id])
  archivedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  variants             DeviceVariant[]
  customerDevices      CustomerDevice[]
  knownFaults          DeviceKnownFault[]
  compatibleParts      ModelPartCompat[]
  articles             KnowledgeArticle[]
  tickets              Ticket[]

  @@index([familyId])
  @@index([name])
}

model DeviceVariant {
  id         String      @id @default(cuid())
  modelId    String
  model      DeviceModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  name       String
  sku        String?
  colour     String?
  storage    String?
  metadata   Json?
  archivedAt DateTime?

  @@index([modelId])
}

model DeviceKnownFault {
  id          String      @id @default(cuid())
  modelId     String
  model       DeviceModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime    @default(now())
}

model ModelPartCompat {
  id      String        @id @default(cuid())
  modelId String
  model   DeviceModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  itemId  String
  item    InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([modelId, itemId])
}

// ---------------------------------------------------------------------------
// Ticketing
// ---------------------------------------------------------------------------

model TicketType {
  id                  String                  @id @default(cuid())
  key                 String                  @unique
  name                String
  prefix              String
  colour              String                  @default("#64748b")
  defaultLabourRateId String?
  defaultLabourRate   LabourRate?             @relation(fields: [defaultLabourRateId], references: [id])
  defaultWarrantyDays Int                     @default(90)
  isSystem            Boolean                 @default(false)
  sortOrder           Int                     @default(0)
  archivedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  tickets             Ticket[]
  customFields        CustomFieldDefinition[]
  diagnosticTemplates DiagnosticTemplate[]
  slaPolicies         SlaPolicy[]
  services            ServiceCatalogue[]
}

model TicketStatus {
  id                      String    @id @default(cuid())
  key                     String    @unique
  name                    String
  colour                  String
  isActive                Boolean   @default(true)
  isCompleted             Boolean   @default(false)
  isCancelled             Boolean   @default(false)
  countsAsWaitingForParts Boolean   @default(false)
  autoSmsTemplateId       String?
  sortOrder               Int       @default(0)
  isSystem                Boolean   @default(false)
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  tickets                 Ticket[]
}

model TicketPriority {
  id                   String      @id @default(cuid())
  key                  String      @unique
  name                 String
  colour               String
  slaResponseMinutes   Int?
  slaCompletionMinutes Int?
  sortOrder            Int         @default(0)
  isDefault            Boolean     @default(false)
  archivedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  tickets              Ticket[]
  slaPolicies          SlaPolicy[]
}

model TicketNumberSequence {
  id         String @id @default(cuid())
  prefix     String
  year       Int
  lastNumber Int    @default(0)

  @@unique([prefix, year])
}

model Ticket {
  id                     String          @id @default(cuid())
  ticketNumber           String          @unique
  customerId             String
  customer               Customer        @relation(fields: [customerId], references: [id])
  customerDeviceId       String?
  customerDevice         CustomerDevice? @relation(fields: [customerDeviceId], references: [id])
  deviceModelId          String?
  deviceModel            DeviceModel?    @relation(fields: [deviceModelId], references: [id])
  typeId                 String
  type                   TicketType      @relation(fields: [typeId], references: [id])
  statusId               String
  status                 TicketStatus    @relation(fields: [statusId], references: [id])
  priorityId             String
  priority               TicketPriority  @relation(fields: [priorityId], references: [id])
  reportedIssue          String
  accessNotes            String?
  estimatedPrice         Decimal?        @db.Decimal(12, 2)
  estimatedLabourMinutes Int?
  dueAt                  DateTime?
  requiredAt             DateTime?
  createdById            String
  createdBy              User            @relation("TicketCreatedBy", fields: [createdById], references: [id])
  assignedToId           String?
  assignedTo             User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  closedById             String?
  closedBy               User?           @relation("TicketClosedBy", fields: [closedById], references: [id])
  closedAt               DateTime?
  slaResponseDue         DateTime?
  slaCompletionDue       DateTime?
  slaState               SlaState        @default(NONE)
  firstResponseAt        DateTime?
  waitingForParts        Boolean         @default(false)
  isWarrantyReturn       Boolean         @default(false)
  originalTicketId       String?
  originalTicket         Ticket?         @relation("WarrantyReturn", fields: [originalTicketId], references: [id])
  warrantyReturns        Ticket[]        @relation("WarrantyReturn")
  intakeAgreementId      String?
  quoteId                String?
  quote                  Quote?          @relation(fields: [quoteId], references: [id])
  pcBuildId              String?         @unique
  pcBuild                PcBuild?        @relation(fields: [pcBuildId], references: [id])
  refurbishmentId        String?         @unique
  refurbishment          Refurbishment?  @relation(fields: [refurbishmentId], references: [id])
  bookingId              String?
  booking                Booking?        @relation(fields: [bookingId], references: [id])
  labourRateId           String?
  labourRate             LabourRate?     @relation(fields: [labourRateId], references: [id])
  diagnosticFeeCents     Int             @default(0)
  diagnosticFeeWaived    Boolean         @default(false)
  diagnosticFeeCredited  Boolean         @default(false)
  archivedAt             DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  notes          TicketNote[]
  events         TicketEvent[]
  attachments    Attachment[]          @relation("TicketAttachments")
  customValues   CustomFieldValue[]
  diagnosticRuns DiagnosticRun[]
  timeEntries    TechnicianTimeEntry[]
  parts          TicketPart[]
  reservations   StockReservation[]
  invoices       Invoice[]
  communications Communication[]
  signatures     Signature[]
  credentials    DeviceCredential?
  conditions     DeviceCondition[]
  warranty       Warranty?
  notifications  Notification[]

  @@index([customerId])
  @@index([statusId])
  @@index([priorityId])
  @@index([typeId])
  @@index([assignedToId])
  @@index([dueAt])
  @@index([createdAt])
  @@index([slaState])
  @@index([waitingForParts])
  @@index([archivedAt])
}

model CustomFieldDefinition {
  id           String             @id @default(cuid())
  entityType   String
  ticketTypeId String?
  ticketType   TicketType?        @relation(fields: [ticketTypeId], references: [id])
  key          String
  label        String
  fieldType    CustomFieldType
  options      Json?
  required     Boolean            @default(false)
  sortOrder    Int                @default(0)
  archivedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  values       CustomFieldValue[]

  @@index([entityType, ticketTypeId])
}

model CustomFieldValue {
  id           String                @id @default(cuid())
  definitionId String
  definition   CustomFieldDefinition @relation(fields: [definitionId], references: [id])
  ticketId     String?
  ticket       Ticket?               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  entityId     String
  value        Json
  updatedAt    DateTime              @updatedAt

  @@unique([definitionId, entityId])
  @@index([ticketId])
}

model TicketNote {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ticketId, createdAt])
}

model TicketEvent {
  id         String                  @id @default(cuid())
  ticketId   String
  ticket     Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId    String?
  type       String
  summary    String
  visibility CommunicationVisibility @default(INTERNAL)
  metadata   Json?
  createdAt  DateTime                @default(now())

  @@index([ticketId, createdAt])
}

model Attachment {
  id           String    @id @default(cuid())
  ownerType    String
  ownerId      String
  ticketId     String?
  ticket       Ticket?   @relation("TicketAttachments", fields: [ticketId], references: [id])
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  checksum     String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  archivedAt   DateTime?

  @@index([ownerType, ownerId])
  @@index([ticketId])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  name      String
  entity    String
  query     Json
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, entity])
}

// ---------------------------------------------------------------------------
// Diagnostics & labour
// ---------------------------------------------------------------------------

model DiagnosticTemplate {
  id           String                   @id @default(cuid())
  name         String
  deviceClass  String?
  ticketTypeId String?
  ticketType   TicketType?              @relation(fields: [ticketTypeId], references: [id])
  phase        String                   @default("pre")
  archivedAt   DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  items        DiagnosticTemplateItem[]
  models       DeviceModel[]
  runs         DiagnosticRun[]
  services     ServiceCatalogue[]
}

model DiagnosticTemplateItem {
  id         String             @id @default(cuid())
  templateId String
  template   DiagnosticTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label      String
  sortOrder  Int                @default(0)
  results    DiagnosticResult[]
}

model DiagnosticRun {
  id           String             @id @default(cuid())
  ticketId     String
  ticket       Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  templateId   String
  template     DiagnosticTemplate @relation(fields: [templateId], references: [id])
  phase        String
  technicianId String?
  notes        String?
  createdAt    DateTime           @default(now())
  results      DiagnosticResult[]

  @@index([ticketId])
}

model DiagnosticResult {
  id     String                 @id @default(cuid())
  runId  String
  run    DiagnosticRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId String
  item   DiagnosticTemplateItem @relation(fields: [itemId], references: [id])
  value  DiagnosticValue        @default(NOT_TESTED)
  notes  String?
}

model LabourRate {
  id          String                @id @default(cuid())
  key         String                @unique
  name        String
  hourlyRate  Decimal               @db.Decimal(12, 2)
  costRate    Decimal               @default(0) @db.Decimal(12, 2)
  isDefault   Boolean               @default(false)
  archivedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  tickets     Ticket[]
  ticketTypes TicketType[]
  services    ServiceCatalogue[]
  timeEntries TechnicianTimeEntry[]
}

model TechnicianTimeEntry {
  id             String         @id @default(cuid())
  ticketId       String
  ticket         Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technicianId   String
  technician     User           @relation(fields: [technicianId], references: [id])
  labourRateId   String?
  labourRate     LabourRate?    @relation(fields: [labourRateId], references: [id])
  state          TimeEntryState @default(RUNNING)
  startedAt      DateTime
  endedAt        DateTime?
  pausedSeconds  Int            @default(0)
  pauseStartedAt DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([ticketId])
  @@index([technicianId, state])
}

model ServiceCatalogue {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  jobTypeId             String?
  jobType               TicketType?            @relation(fields: [jobTypeId], references: [id])
  defaultPrice          Decimal                @db.Decimal(12, 2)
  expectedLabourMinutes Int                    @default(30)
  labourRateId          String?
  labourRate            LabourRate?            @relation(fields: [labourRateId], references: [id])
  diagnosticTemplateId  String?
  diagnosticTemplate    DiagnosticTemplate?    @relation(fields: [diagnosticTemplateId], references: [id])
  warrantyDays          Int                    @default(90)
  archivedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  typicalParts          ServiceCataloguePart[]

  @@index([name])
}

model ServiceCataloguePart {
  id        String           @id @default(cuid())
  serviceId String
  service   ServiceCatalogue @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  itemId    String
  item      InventoryItem    @relation(fields: [itemId], references: [id])
  quantity  Int              @default(1)
}

// ---------------------------------------------------------------------------
// Inventory / suppliers
// ---------------------------------------------------------------------------

model InventoryItem {
  id             String               @id @default(cuid())
  kind           ItemKind             @default(REPAIR_PART)
  sku            String               @unique
  barcode        String?              @unique
  name           String
  category       String
  pcCategory     PcComponentCategory?
  manufacturer   String?
  supplierId     String?
  supplier       Supplier?            @relation(fields: [supplierId], references: [id])
  description    String?
  specifications Json?
  onHand         Int                  @default(0)
  reserved       Int                  @default(0)
  cost           Decimal              @default(0) @db.Decimal(12, 2)
  salePrice      Decimal              @default(0) @db.Decimal(12, 2)
  gstTreatment   GstTreatment         @default(INCLUSIVE)
  minStock       Int                  @default(0)
  reorderQty     Int                  @default(1)
  warrantyDays   Int?
  locationNote   String?
  archivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  serialized        SerializedItem[]
  transactions      InventoryTransaction[]
  reservations      StockReservation[]
  ticketParts       TicketPart[]
  poItems           PurchaseOrderItem[]
  costHistory       PartCostHistory[]
  warranties        PartWarranty[]
  compat            ModelPartCompat[]
  serviceLinks      ServiceCataloguePart[]
  pcBuildComponents PcBuildComponent[]
  stocktakeLines    StocktakeLine[]

  @@index([kind])
  @@index([category])
  @@index([name])
  @@index([supplierId])
  @@index([archivedAt])
}

model SerializedItem {
  id              String              @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  serialNumber    String
  imei            String?
  status          SerializedStatus    @default(IN_STOCK)
  cost            Decimal             @db.Decimal(12, 2)
  ticketId        String?
  pcBuildId       String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  warranties      PartWarranty[]
  usedPurchase    UsedDevicePurchase?
  returnRecords   ReturnRecord[]

  @@unique([inventoryItemId, serialNumber])
  @@index([serialNumber])
  @@index([imei])
  @@index([status])
}

model InventoryTransaction {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id])
  type      String
  quantity  Int
  reason    String?
  reference String?
  actorId   String?
  createdAt DateTime      @default(now())
  metadata  Json?

  @@index([itemId, createdAt])
}

model StockReservation {
  id               String            @id @default(cuid())
  itemId           String
  item             InventoryItem     @relation(fields: [itemId], references: [id])
  quantity         Int
  target           ReservationTarget
  ticketId         String?
  ticket           Ticket?           @relation(fields: [ticketId], references: [id])
  pcBuildId        String?
  pcBuild          PcBuild?          @relation(fields: [pcBuildId], references: [id])
  serializedItemId String?
  releasedAt       DateTime?
  createdAt        DateTime          @default(now())

  @@index([itemId])
  @@index([ticketId])
  @@index([pcBuildId])
}

model TicketPart {
  id               String         @id @default(cuid())
  ticketId         String
  ticket           Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  itemId           String?
  item             InventoryItem? @relation(fields: [itemId], references: [id])
  name             String
  sku              String?
  quantity         Int            @default(1)
  status           PartNeedStatus @default(NEED_TO_ORDER)
  unitCost         Decimal        @default(0) @db.Decimal(12, 2)
  unitPrice        Decimal        @default(0) @db.Decimal(12, 2)
  serializedItemId String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([ticketId])
  @@index([status])
}

model Supplier {
  id             String                  @id @default(cuid())
  name           String
  contactName    String?
  phone          String?
  email          String?
  website        String?
  accountNumber  String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          InventoryItem[]
  purchaseOrders PurchaseOrder[]
  costHistory    PartCostHistory[]
  warranties     PartWarranty[]
  claims         SupplierWarrantyClaim[]

  @@index([name])
  @@index([archivedAt])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  expectedAt  DateTime?
  notes       String?
  createdById String
  createdBy   User                @relation("PoCreatedBy", fields: [createdById], references: [id])
  submittedAt DateTime?
  receivedAt  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id])
  quantity        Int
  receivedQty     Int           @default(0)
  unitCost        Decimal       @db.Decimal(12, 2)
  gstTreatment    GstTreatment  @default(INCLUSIVE)
  expectedAt      DateTime?
  ticketId        String?

  @@index([purchaseOrderId])
}

model PartCostHistory {
  id         String        @id @default(cuid())
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id])
  supplierId String?
  supplier   Supplier?     @relation(fields: [supplierId], references: [id])
  unitCost   Decimal       @db.Decimal(12, 2)
  recordedAt DateTime      @default(now())
  source     String?

  @@index([itemId, recordedAt])
}

model PartWarranty {
  id                String                  @id @default(cuid())
  itemId            String
  item              InventoryItem           @relation(fields: [itemId], references: [id])
  serializedItemId  String?
  serializedItem    SerializedItem?         @relation(fields: [serializedItemId], references: [id])
  supplierId        String?
  supplier          Supplier?               @relation(fields: [supplierId], references: [id])
  purchaseDate      DateTime?
  expiresAt         DateTime?
  installedTicketId String?
  customerId        String?
  notes             String?
  createdAt         DateTime                @default(now())
  claims            SupplierWarrantyClaim[]
}

model SupplierWarrantyClaim {
  id          String       @id @default(cuid())
  warrantyId  String
  warranty    PartWarranty @relation(fields: [warrantyId], references: [id])
  supplierId  String
  supplier    Supplier     @relation(fields: [supplierId], references: [id])
  failureDate DateTime
  notes       String?
  status      String       @default("open")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Stocktake {
  id          String          @id @default(cuid())
  name        String
  status      String          @default("open")
  startedById String
  startedBy   User            @relation(fields: [startedById], references: [id])
  completedAt DateTime?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lines       StocktakeLine[]
}

model StocktakeLine {
  id          String        @id @default(cuid())
  stocktakeId String
  stocktake   Stocktake     @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  expectedQty Int
  actualQty   Int?
  variance    Int?
  reason      String?
}

// ---------------------------------------------------------------------------
// Quotes / invoices / payments
// ---------------------------------------------------------------------------

model Quote {
  id                  String      @id @default(cuid())
  number              String      @unique
  customerId          String
  customer            Customer    @relation(fields: [customerId], references: [id])
  status              QuoteStatus @default(DRAFT)
  deviceSummary       String?
  issue               String?
  notes               String?
  customerNotes       String?
  expiryDate          DateTime?
  estimatedCompletion DateTime?
  subtotal            Decimal     @default(0) @db.Decimal(12, 2)
  discount            Decimal     @default(0) @db.Decimal(12, 2)
  gst                 Decimal     @default(0) @db.Decimal(12, 2)
  total               Decimal     @default(0) @db.Decimal(12, 2)
  approvalStatus      String      @default("pending")
  approvalNotes       String?
  approvedAt          DateTime?
  createdById         String
  createdBy           User        @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  convertedTicketId   String?
  convertedPcBuildId  String?
  archivedAt          DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  lines               QuoteLine[]
  tickets             Ticket[]
  pcBuilds            PcBuild[]
  signatures          Signature[]

  @@index([customerId])
  @@index([status])
}

model QuoteLine {
  id           String          @id @default(cuid())
  quoteId      String
  quote        Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  type         InvoiceLineType
  description  String
  quantity     Decimal         @default(1) @db.Decimal(12, 2)
  unitPrice    Decimal         @db.Decimal(12, 2)
  gstTreatment GstTreatment    @default(INCLUSIVE)
  itemId       String?
  sortOrder    Int             @default(0)
}

model Invoice {
  id             String         @id @default(cuid())
  number         String         @unique
  customerId     String
  customer       Customer       @relation(fields: [customerId], references: [id])
  ticketId       String?
  ticket         Ticket?        @relation(fields: [ticketId], references: [id])
  pcBuildId      String?
  pcBuild        PcBuild?       @relation(fields: [pcBuildId], references: [id])
  status         InvoiceStatus  @default(DRAFT)
  issuedAt       DateTime?
  dueAt          DateTime?
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  gst            Decimal        @default(0) @db.Decimal(12, 2)
  total          Decimal        @default(0) @db.Decimal(12, 2)
  amountPaid     Decimal        @default(0) @db.Decimal(12, 2)
  amountRefunded Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  createdById    String
  createdBy      User           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  voidedAt       DateTime?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  lines          InvoiceLine[]
  payments       Payment[]
  refunds        Refund[]
  returns        ReturnRecord[]

  @@index([customerId])
  @@index([ticketId])
  @@index([status])
  @@index([issuedAt])
}

model InvoiceLine {
  id           String          @id @default(cuid())
  invoiceId    String
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type         InvoiceLineType
  description  String
  quantity     Decimal         @default(1) @db.Decimal(12, 2)
  unitPrice    Decimal         @db.Decimal(12, 2)
  gstTreatment GstTreatment    @default(INCLUSIVE)
  itemId       String?
  sortOrder    Int             @default(0)
}

model PaymentMethod {
  id        String    @id @default(cuid())
  key       String    @unique
  name      String
  provider  String    @default("manual")
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  payments  Payment[]
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])
  methodId      String
  method        PaymentMethod @relation(fields: [methodId], references: [id])
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  provider      String        @default("manual")
  providerRef   String?
  failureReason String?
  notes         String?
  isDeposit     Boolean       @default(false)
  recordedById  String
  recordedBy    User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  receivedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  refunds       Refund[]

  @@index([invoiceId])
  @@index([status])
  @@index([receivedAt])
}

model Refund {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id])
  amount          Decimal  @db.Decimal(12, 2)
  reason          String
  method          String?
  inventoryImpact String?
  issuedById      String
  issuedBy        User     @relation("RefundIssuedBy", fields: [issuedById], references: [id])
  createdAt       DateTime @default(now())

  @@index([invoiceId])
}

model ReturnRecord {
  id               String            @id @default(cuid())
  invoiceId        String
  invoice          Invoice           @relation(fields: [invoiceId], references: [id])
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  serializedItemId String?
  serializedItem   SerializedItem?   @relation(fields: [serializedItemId], references: [id])
  disposition      ReturnDisposition
  notes            String?
  createdAt        DateTime          @default(now())
}

model DocumentNumberSequence {
  id         String @id @default(cuid())
  kind       String
  year       Int
  lastNumber Int    @default(0)

  @@unique([kind, year])
}

// ---------------------------------------------------------------------------
// Warranties, agreements, credentials
// ---------------------------------------------------------------------------

model Warranty {
  id           String          @id @default(cuid())
  ticketId     String?         @unique
  ticket       Ticket?         @relation(fields: [ticketId], references: [id])
  pcBuildId    String?         @unique
  pcBuild      PcBuild?        @relation(fields: [pcBuildId], references: [id])
  customerId   String
  customer     Customer        @relation(fields: [customerId], references: [id])
  templateKey  String?
  terms        String?
  durationDays Int
  startsAt     DateTime
  expiresAt    DateTime
  createdAt    DateTime        @default(now())
  claims       WarrantyClaim[]
}

model WarrantyClaim {
  id         String   @id @default(cuid())
  warrantyId String
  warranty   Warranty @relation(fields: [warrantyId], references: [id])
  ticketId   String?
  notes      String?
  createdAt  DateTime @default(now())
}

model IntakeAgreementTemplate {
  id          String                      @id @default(cuid())
  name        String
  version     Int                         @default(1)
  body        String
  clauses     Json
  isActive    Boolean                     @default(true)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  acceptances IntakeAgreementAcceptance[]
}

model IntakeAgreementAcceptance {
  id          String                  @id @default(cuid())
  templateId  String
  template    IntakeAgreementTemplate @relation(fields: [templateId], references: [id])
  ticketId    String
  customerId  String
  staffId     String
  signatureId String?
  clauses     Json
  acceptedAt  DateTime                @default(now())
}

model PrivacyNoticeTemplate {
  id        String           @id @default(cuid())
  name      String
  version   Int              @default(1)
  body      String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  consents  PrivacyConsent[]
}

model PrivacyConsent {
  id         String                @id @default(cuid())
  templateId String
  template   PrivacyNoticeTemplate @relation(fields: [templateId], references: [id])
  customerId String
  customer   Customer              @relation(fields: [customerId], references: [id])
  ticketId   String?
  staffId    String
  acceptedAt DateTime              @default(now())
}

model Signature {
  id              String           @id @default(cuid())
  purpose         SignaturePurpose
  ticketId        String?
  ticket          Ticket?          @relation(fields: [ticketId], references: [id])
  quoteId         String?
  quote           Quote?           @relation(fields: [quoteId], references: [id])
  customerId      String?
  staffId         String
  staff           User             @relation("SignatureStaff", fields: [staffId], references: [id])
  imageKey        String
  documentVersion String?
  signedAt        DateTime         @default(now())
  metadata        Json?
}

model DeviceCredential {
  id            String    @id @default(cuid())
  ticketId      String    @unique
  ticket        Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ciphertext    String
  label         String    @default("Device PIN / password")
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  deletedReason String?
}

model DeviceCondition {
  id              String   @id @default(cuid())
  ticketId        String
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  phase           String
  scratches       Boolean  @default(false)
  dents           Boolean  @default(false)
  crackedGlass    Boolean  @default(false)
  bentChassis     Boolean  @default(false)
  missingScrews   Boolean  @default(false)
  waterIndicators Boolean  @default(false)
  missingCovers   Boolean  @default(false)
  otherDamage     String?
  notes           String?
  photoKeys       Json?
  recordedById    String?
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// PC builds
// ---------------------------------------------------------------------------

model PcBuild {
  id                String             @id @default(cuid())
  number            String             @unique
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id])
  customerDeviceId  String?
  customerDevice    CustomerDevice?    @relation(fields: [customerDeviceId], references: [id])
  status            PcBuildStatus      @default(QUOTE)
  quoteId           String?
  quote             Quote?             @relation(fields: [quoteId], references: [id])
  assignedToId      String?
  assignedTo        User?              @relation("PcBuildAssignee", fields: [assignedToId], references: [id])
  budget            Decimal?           @db.Decimal(12, 2)
  useCase           String?
  targetWorkloads   String?
  preferredBrands   String?
  appearance        String?
  notes             String?
  partsCost         Decimal            @default(0) @db.Decimal(12, 2)
  labourAmount      Decimal            @default(0) @db.Decimal(12, 2)
  markupAmount      Decimal            @default(0) @db.Decimal(12, 2)
  gstAmount         Decimal            @default(0) @db.Decimal(12, 2)
  estimatedPrice    Decimal            @default(0) @db.Decimal(12, 2)
  finalPrice        Decimal?           @db.Decimal(12, 2)
  depositAmount     Decimal            @default(0) @db.Decimal(12, 2)
  dueAt             DateTime?
  compatibilityJson Json?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  components        PcBuildComponent[]
  benchmarks        BenchmarkResult[]
  reservations      StockReservation[]
  invoices          Invoice[]
  ticket            Ticket?
  warranty          Warranty?

  @@index([customerId])
  @@index([status])
}

model PcBuildComponent {
  id        String              @id @default(cuid())
  buildId   String
  build     PcBuild             @relation(fields: [buildId], references: [id], onDelete: Cascade)
  itemId    String?
  item      InventoryItem?      @relation(fields: [itemId], references: [id])
  category  PcComponentCategory
  name      String
  quantity  Int                 @default(1)
  unitCost  Decimal             @db.Decimal(12, 2)
  unitPrice Decimal             @db.Decimal(12, 2)
  specs     Json?
  notes     String?
}

model BenchmarkResult {
  id           String   @id @default(cuid())
  buildId      String
  build        PcBuild  @relation(fields: [buildId], references: [id], onDelete: Cascade)
  kind         String
  notes        String?
  temperature  Decimal? @db.Decimal(6, 1)
  attachmentId String?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Used tech
// ---------------------------------------------------------------------------

model UsedDevicePurchase {
  id                  String           @id @default(cuid())
  number              String           @unique
  sellerCustomerId    String
  seller              Customer         @relation("UsedSeller", fields: [sellerCustomerId], references: [id])
  deviceSummary       String
  serial              String?
  imei                String?
  conditionGrade      ConditionGrade
  faults              String?
  specifications      Json?
  accessories         String?
  expectedResale      Decimal          @db.Decimal(12, 2)
  expectedRepairCost  Decimal          @default(0) @db.Decimal(12, 2)
  feesAllowance       Decimal          @default(0) @db.Decimal(12, 2)
  requiredProfit      Decimal          @default(0) @db.Decimal(12, 2)
  recommendedMaxOffer Decimal          @db.Decimal(12, 2)
  purchasePrice       Decimal          @db.Decimal(12, 2)
  overrideReason      String?
  status              UsedDeviceStatus @default(ASSESSED)
  serializedItemId    String?          @unique
  serializedItem      SerializedItem?  @relation(fields: [serializedItemId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  refurbishment       Refurbishment?
}

model Refurbishment {
  id             String             @id @default(cuid())
  purchaseId     String             @unique
  purchase       UsedDevicePurchase @relation(fields: [purchaseId], references: [id])
  partsCost      Decimal            @default(0) @db.Decimal(12, 2)
  labourCost     Decimal            @default(0) @db.Decimal(12, 2)
  totalInvested  Decimal            @default(0) @db.Decimal(12, 2)
  salePrice      Decimal?           @db.Decimal(12, 2)
  soldPrice      Decimal?           @db.Decimal(12, 2)
  readyForSaleAt DateTime?
  ticket         Ticket?
}

model MarketplaceListing {
  id         String    @id @default(cuid())
  adapter    String
  externalId String?
  title      String
  payload    Json
  status     String    @default("draft")
  itemId     String?
  pcBuildId  String?
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Calendar / roster / notifications
// ---------------------------------------------------------------------------

model BookingType {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  colour      String    @default("#0f766e")
  durationMin Int       @default(30)
  archivedAt  DateTime?
  bookings    Booking[]
}

model Booking {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id])
  typeId     String
  type       BookingType   @relation(fields: [typeId], references: [id])
  staffId    String?
  staff      User?         @relation("BookingStaff", fields: [staffId], references: [id])
  startsAt   DateTime
  endsAt     DateTime
  status     BookingStatus @default(SCHEDULED)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  tickets    Ticket[]

  @@index([startsAt])
  @@index([staffId])
  @@index([customerId])
}

model RosterShift {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId, startsAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  severity  String    @default("info")
  readAt    DateTime?
  ticketId  String?
  ticket    Ticket?   @relation(fields: [ticketId], references: [id])
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Knowledge / communications
// ---------------------------------------------------------------------------

model KnowledgeCategory {
  id       String             @id @default(cuid())
  name     String             @unique
  slug     String             @unique
  articles KnowledgeArticle[]
}

model KnowledgeArticle {
  id             String             @id @default(cuid())
  title          String
  slug           String             @unique
  body           String
  tags           String[]
  categoryId     String?
  category       KnowledgeCategory? @relation(fields: [categoryId], references: [id])
  manufacturerId String?
  manufacturer   Manufacturer?      @relation(fields: [manufacturerId], references: [id])
  familyId       String?
  family         DeviceFamily?      @relation(fields: [familyId], references: [id])
  modelId        String?
  model          DeviceModel?       @relation(fields: [modelId], references: [id])
  repairType     String?
  authorId       String
  author         User               @relation("ArticleAuthor", fields: [authorId], references: [id])
  published      Boolean            @default(true)
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([title])
}

model Communication {
  id          String                  @id @default(cuid())
  ticketId    String?
  ticket      Ticket?                 @relation(fields: [ticketId], references: [id])
  customerId  String?
  customer    Customer?               @relation(fields: [customerId], references: [id])
  channel     CommunicationChannel
  visibility  CommunicationVisibility @default(CUSTOMER)
  direction   String                  @default("outbound")
  toAddress   String?
  subject     String?
  body        String
  providerRef String?
  status      String                  @default("sent")
  staffId     String?
  staff       User?                   @relation(fields: [staffId], references: [id])
  createdAt   DateTime                @default(now())

  @@index([ticketId, createdAt])
  @@index([customerId, createdAt])
}

model SmsTemplate {
  id               String  @id @default(cuid())
  key              String  @unique
  name             String
  body             String
  triggerStatusKey String?
  enabled          Boolean @default(true)
}

model EmailTemplate {
  id      String  @id @default(cuid())
  key     String  @unique
  name    String
  subject String
  body    String
  enabled Boolean @default(true)
}

model DocumentTemplate {
  id      String  @id @default(cuid())
  key     String  @unique
  name    String
  body    String
  enabled Boolean @default(true)
}

model PrinterProfile {
  id            String  @id @default(cuid())
  name          String
  kind          String
  paperWidthMm  Int?
  paperHeightMm Int?
  isDefault     Boolean @default(false)
  settings      Json?
}

model SlaPolicy {
  id                String          @id @default(cuid())
  name              String
  ticketTypeId      String?
  ticketType        TicketType?     @relation(fields: [ticketTypeId], references: [id])
  priorityId        String?
  priority          TicketPriority? @relation(fields: [priorityId], references: [id])
  customerCategory  String?
  responseMinutes   Int
  completionMinutes Int
  isActive          Boolean         @default(true)
}

// ---------------------------------------------------------------------------
// Privacy / audit / backups / health
// ---------------------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([action])
}

model RetentionPolicy {
  id         String   @id @default(cuid())
  recordType String   @unique
  days       Int?
  action     String   @default("archive")
  enabled    Boolean  @default(false)
  warningAck Boolean  @default(false)
  notes      String?
  updatedAt  DateTime @updatedAt
}

model SecurityIncident {
  id                String                  @id @default(cuid())
  number            String                  @unique
  detectedAt        DateTime
  reportedById      String?
  reportedBy        User?                   @relation("IncidentReporter", fields: [reportedById], references: [id])
  description       String
  dataAffected      String?
  customersAffected String?
  systemsAffected   String?
  investigation     String?
  containment       String?
  remediation       String?
  notifications     String?
  notifyDecision    String?
  notifyNotes       String?
  status            IncidentStatus          @default(OPEN)
  closedAt          DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  events            SecurityIncidentEvent[]
}

model SecurityIncidentEvent {
  id         String           @id @default(cuid())
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  body       String
  actorId    String?
  createdAt  DateTime         @default(now())
}

model BackupRecord {
  id          String       @id @default(cuid())
  type        String
  status      BackupStatus @default(RUNNING)
  destination String
  storageKey  String?
  sizeBytes   Int?
  checksum    String?
  error       String?
  startedById String?
  startedBy   User?        @relation(fields: [startedById], references: [id])
  verifiedAt  DateTime?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
}

model HealthCheck {
  id        String      @id @default(cuid())
  key       String
  state     HealthState
  detail    String?
  checkedAt DateTime    @default(now())

  @@index([key, checkedAt])
}

model ImportJob {
  id          String    @id @default(cuid())
  entity      String
  status      String    @default("preview")
  fileName    String
  summary     Json?
  error       String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  committedAt DateTime?
}

model UpdateRecord {
  id          String    @id @default(cuid())
  fromVersion String
  toVersion   String
  status      String
  log         String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
}

model PricingObservation {
  id           String   @id @default(cuid())
  deviceKey    String
  repairType   String
  partCost     Decimal  @db.Decimal(12, 2)
  estimatedMin Int
  actualMin    Int
  salePrice    Decimal  @db.Decimal(12, 2)
  profit       Decimal  @db.Decimal(12, 2)
  margin       Decimal  @db.Decimal(6, 3)
  createdAt    DateTime @default(now())

  @@index([deviceKey, repairType])
}
