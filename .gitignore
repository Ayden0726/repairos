## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
*.DotSettings.user

# .NET
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
TestResults/

# Secrets / local
.env
docker/.use-pi-profile
appsettings.*.local.json
**/Properties/launchSettings.json.user

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Old / local data (repo-root only — do not ignore Infrastructure/Data seed JSON)
/data/
*.rdb

# Keep embedded service catalogue seed
!services/shared/WorkshopOS.Infrastructure/Data/
!services/shared/WorkshopOS.Infrastructure/Data/**
node_modules/
.next/
workshopos-build-client-*.zip
packaging/out/

# Packaging outputs
packaging/dist/
packaging/out/
packaging/staging/
