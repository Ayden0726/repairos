NODE_ENV=production
APP_NAME=WorkshopOS
APP_VERSION=1.0.0
APP_URL=https://workshop.example.com
PORT=47821

# PostgreSQL
DATABASE_URL=postgresql://workshopos:change-me@postgres:5432/workshopos?schema=public
POSTGRES_PASSWORD=change-me

# Redis
REDIS_URL=redis://redis:6379

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-chars-minimum
# 32-byte key as 64 hex characters
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
FILE_STORAGE_DRIVER=local

# Optional S3 / MinIO
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=workshopos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Public hostname for Caddy
DOMAIN=workshop.example.com

# Set true only on a development server
SEED_DEMO=false
