# Multi-arch runtime: linux/amd64, linux/arm64, linux/arm/v7 (Raspberry Pi 3B+).
# Native `docker compose build` on a Pi produces the matching ARM image.
FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim AS build
ARG TARGETARCH
WORKDIR /src
COPY . .
# Docker TARGETARCH uses amd64; `dotnet -a` expects x64. When TARGETARCH is unset, publish for the host RID.
RUN set -eux; \
    if [ -n "${TARGETARCH:-}" ]; then \
      case "$TARGETARCH" in \
        amd64) DOTNET_ARCH=x64 ;; \
        arm64) DOTNET_ARCH=arm64 ;; \
        arm)   DOTNET_ARCH=arm ;; \
        *)     DOTNET_ARCH="$TARGETARCH" ;; \
      esac; \
      echo "Publishing API for .NET arch=$DOTNET_ARCH (Docker TARGETARCH=$TARGETARCH)"; \
      dotnet restore WorkshopOS.sln -a "$DOTNET_ARCH"; \
      dotnet publish services/api/WorkshopOS.Api/WorkshopOS.Api.csproj \
        -c Release -a "$DOTNET_ARCH" -o /app/publish \
        /p:UseAppHost=false /p:PublishReadyToRun=false; \
    else \
      echo "Publishing API for host RID"; \
      dotnet restore WorkshopOS.sln; \
      dotnet publish services/api/WorkshopOS.Api/WorkshopOS.Api.csproj \
        -c Release -o /app/publish \
        /p:UseAppHost=false /p:PublishReadyToRun=false; \
    fi

FROM mcr.microsoft.com/dotnet/aspnet:8.0-bookworm-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://0.0.0.0:8080 \
    DOTNET_EnableDiagnostics=0
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8080/api/health || exit 1
ENTRYPOINT ["dotnet", "WorkshopOS.Api.dll"]
