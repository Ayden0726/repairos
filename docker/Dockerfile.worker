FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore WorkshopOS.sln
RUN dotnet publish services/worker/WorkshopOS.Worker/WorkshopOS.Worker.csproj -c Release -o /app/publish /p:UseAppHost=false

# Worker hosts ASP.NET Core DI / EF bits — needs the aspnet shared framework, not runtime-only.
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "WorkshopOS.Worker.dll"]
