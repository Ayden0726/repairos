POSTGRES_PASSWORD=change-me
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
# Dedicated master key for encrypting API credentials at rest (AES-256-GCM).
# Generate once and keep forever: openssl rand -base64 48
# Do NOT change after credentials are saved unless you run a planned rotation.
Encryption__Key=replace-with-a-different-long-random-secret-32+
Encryption__KeyVersion=1
API_PORT=5088
SEED_DEMO=false
ASPNETCORE_ENVIRONMENT=Production
