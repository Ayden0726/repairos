<Page
    x:Class="WorkshopOS.Client.Views.PcBuildsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkshopOS.Client.Views"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Spacing="4">
      <TextBlock Text="PC Builds" FontSize="24" FontWeight="SemiBold"
                 Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
      <TextBlock Text="Build systems from inventory. Selected parts are reserved exclusively for each build."
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
      <Button Grid.Column="2" Content="New build" Click="NewBuild_Click"
              Style="{StaticResource AccentButtonStyle}" />
    </Grid>

    <Grid Grid.Row="2" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="4">
        <ProgressRing Width="28" Height="28" HorizontalAlignment="Left"
                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                   Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <ListView Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                IsItemClickEnabled="True"
                ItemClick="Build_ItemClick">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="local:PcBuildRowVm">
            <Grid Padding="4,10" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"
                             Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                  <Border Padding="8,2" CornerRadius="4"
                          Background="{ThemeResource WorkshopAccentSoftBrush}">
                    <TextBlock Text="{x:Bind Status}" FontSize="12" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{x:Bind CustomerLine}" FontSize="12"
                           Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
                <TextBlock Text="{x:Bind TotalsLine}" FontSize="12"
                           Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                         Foreground="{ThemeResource WorkshopTextPrimaryBrush}"
                         Text="{x:Bind MarginLine}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</Page>
