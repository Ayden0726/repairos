<Page x:Class="WorkshopOS.Client.Views.AcquisitionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="using:WorkshopOS.Contracts.Operations"
      Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="8">
      <TextBlock Text="Acquisitions" FontSize="22" FontWeight="SemiBold"
                 Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
      <TextBlock Text="Buy-in leads before they become refurbished stock. Convert accepted leads into inventory."
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Header="Search" Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />
        <ComboBox Grid.Column="1" Header="Status"
                  ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" />
        <Button Grid.Column="2" Content="Refresh" VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.RefreshCommand}" />
      </Grid>
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.75" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:AcquisitionLeadListItemDto">
            <StackPanel Spacing="2" Padding="4,8">
              <TextBlock FontWeight="SemiBold">
                <Run Text="{x:Bind Reference}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
              </TextBlock>
              <TextBlock FontSize="12" Opacity="0.75">
                <Run Text="{x:Bind Brand}" /><Run Text=" " /><Run Text="{x:Bind Model}" />
                <Run Text=" · " /><Run Text="{x:Bind AcquisitionSource}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
    <Border Grid.Column="1" Padding="16" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <ScrollViewer>
        <StackPanel Spacing="8">
          <TextBlock Text="New acquisition lead" FontWeight="SemiBold" FontSize="16" />
          <TextBox Header="Brand" Text="{x:Bind ViewModel.Brand, Mode=TwoWay}" />
          <TextBox Header="Model" Text="{x:Bind ViewModel.Model, Mode=TwoWay}" />
          <TextBox Header="IMEI" Text="{x:Bind ViewModel.Imei, Mode=TwoWay}" />
          <TextBox Header="Seller name" Text="{x:Bind ViewModel.SellerName, Mode=TwoWay}" />
          <TextBox Header="Source" Text="{x:Bind ViewModel.Source, Mode=TwoWay}"
                   PlaceholderText="Walk-in, Marketplace, Trade-in…" />
          <TextBox Header="Asking price" Text="{x:Bind ViewModel.AskingPrice, Mode=TwoWay}" />
          <TextBox Header="Proposed offer" Text="{x:Bind ViewModel.ProposedOffer, Mode=TwoWay}" />
          <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}"
                   AcceptsReturn="True" Height="56" TextWrapping="Wrap" />
          <Button Content="Create lead" Command="{x:Bind ViewModel.CreateCommand}"
                  Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
          <TextBlock Text="Selected lead" FontWeight="SemiBold" Margin="0,12,0,0" />
          <TextBlock Text="{x:Bind ViewModel.SelectedLabel, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.8" />
          <ComboBox Header="Set status"
                    ItemsSource="{x:Bind ViewModel.LeadStatusOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
          <Button Content="Update status" Command="{x:Bind ViewModel.UpdateStatusCommand}"
                  HorizontalAlignment="Stretch" />
          <Button Content="Convert to refurbished stock" Command="{x:Bind ViewModel.ConvertCommand}"
                  Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Page>
