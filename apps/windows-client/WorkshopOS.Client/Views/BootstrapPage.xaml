<Page
    x:Class="WorkshopOS.Client.Views.BootstrapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <!-- Kept for compatibility only. MainWindow never navigates here (1.2.21+). -->
  <Grid Background="{ThemeResource WorkshopPageBackgroundBrush}">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="420" Padding="24"
                Background="{ThemeResource WorkshopPageBackgroundBrush}">
      <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="WorkshopOS" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="ThemeLightBtn" Content="Light" Click="ThemeLight_Click" Padding="10,4" MinWidth="56" />
          <Button x:Name="ThemeDarkBtn" Content="Dark" Click="ThemeDark_Click" Padding="10,4" MinWidth="56"
                  Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
      </Grid>
      <Border Background="{ThemeResource WorkshopAccentSoftBrush}" Padding="10,6" CornerRadius="4" HorizontalAlignment="Center">
        <TextBlock x:Name="BuildBanner" Text="Client 1.2.21" FontSize="14" FontWeight="SemiBold"
                   Foreground="{ThemeResource WorkshopAccentBrush}" />
      </Border>
      <TextBlock x:Name="StatusText" Text="Opening connect screen…"
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}"
                 HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
      <ProgressRing IsActive="True" Width="36" Height="36" HorizontalAlignment="Center" />
      <Button Content="Enter server / pairing code" Click="EnterServer_Click"
              HorizontalAlignment="Stretch" Margin="0,8,0,0" />
    </StackPanel>
  </Grid>
</Page>
