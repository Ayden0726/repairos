<Page x:Class="WorkshopOS.Client.Views.PurchaseOrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="using:WorkshopOS.Contracts.Operations"
      xmlns:local="using:WorkshopOS.Client.Views"
      Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="1.2*" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="8">
      <TextBlock Text="Purchase orders" FontSize="22" FontWeight="SemiBold"
                 Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
      <TextBlock Text="Receive stock against ordered lines. Linked inventory items increase on hand."
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
      <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      <ListView ItemsSource="{x:Bind ViewModel.Orders, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedOrder, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:PurchaseOrderListItemDto">
            <StackPanel Spacing="2" Padding="4,8">
              <TextBlock FontWeight="SemiBold" Foreground="{ThemeResource WorkshopTextPrimaryBrush}">
                <Run Text="{x:Bind Number}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
              </TextBlock>
              <TextBlock FontSize="12" Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
                <Run Text="{x:Bind SupplierName}" /><Run Text=" · " /><Run Text="{x:Bind Total}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
    <Border Grid.Column="1" Padding="16" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="{x:Bind ViewModel.DetailHeader, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <ListView ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="Line_ItemClick">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:PoLineRowVm">
              <Grid Padding="4,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap"
                             Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                  <TextBlock FontSize="12" Opacity="0.75">
                    <Run Text="{x:Bind ProgressLabel}" />
                    <Run Text=" — tap to receive remaining" />
                  </TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>
    </Border>
  </Grid>
</Page>
