<Page
    x:Class="WorkshopOS.Client.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ops="using:WorkshopOS.Contracts.Operations"
    xmlns:vm="using:WorkshopOS.Client.ViewModels"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Page.KeyboardAccelerators>
    <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="CommandCentreAccelerator_Invoked" />
  </Page.KeyboardAccelerators>
  <Grid>
    <NavigationView x:Name="NavView"
                    PaneDisplayMode="Left"
                    IsSettingsVisible="True"
                    IsBackButtonVisible="Collapsed"
                    OpenPaneLength="196"
                    CompactPaneLength="48"
                    IsPaneToggleButtonVisible="True"
                    AlwaysShowHeader="False"
                    Background="{ThemeResource WorkshopPageBackgroundBrush}"
                    ItemInvoked="NavView_ItemInvoked">
      <NavigationView.PaneHeader>
        <StackPanel Padding="12,8,12,4" Spacing="0">
          <TextBlock Text="TechBench NQ" FontWeight="SemiBold" FontSize="13"
                     Foreground="{ThemeResource WorkshopAccentBrush}" />
          <TextBlock Text="{x:Bind ViewModel.BusinessName, Mode=OneWay}" FontSize="11"
                     TextTrimming="CharacterEllipsis" MaxLines="1"
                     Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.PaneFooter>
        <StackPanel Padding="10,6" Spacing="4">
          <TextBlock Text="{x:Bind ViewModel.UserDisplay, Mode=OneWay}" FontSize="11"
                     TextTrimming="CharacterEllipsis" MaxLines="1"
                     Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
          <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ThemeLightBtn" Grid.Column="0" Content="Aa" Click="ThemeLight_Click"
                    Padding="4,2" FontSize="11" ToolTipService.ToolTip="Light theme" />
            <Button x:Name="ThemeDarkBtn" Grid.Column="1" Content="Aa" Click="ThemeDark_Click"
                    Padding="4,2" FontSize="11" ToolTipService.ToolTip="Dark theme"
                    Style="{StaticResource AccentButtonStyle}" />
          </Grid>
          <Button Content="Sign out" Command="{x:Bind ViewModel.LogoutCommand}"
                  HorizontalAlignment="Stretch" Padding="6,4" FontSize="11" />
        </StackPanel>
      </NavigationView.PaneFooter>

      <Grid Background="{ThemeResource WorkshopPageBackgroundBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Padding="12,8" ColumnSpacing="8" Background="{ThemeResource WorkshopChromeBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox"
                   PlaceholderText="Search (Ctrl+K)"
                   Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   KeyDown="OnSearchKeyDown"
                   TextChanged="SearchBox_TextChanged" />
          <Button Grid.Column="1" Content="+ Repair" Click="NewTicket_Click"
                  Style="{StaticResource AccentButtonStyle}" Padding="12,6"
                  ToolTipService.ToolTip="New repair" />
          <Button x:Name="NotificationsButton"
                  Grid.Column="2"
                  Click="Notifications_Click"
                  Padding="8,6"
                  ToolTipService.ToolTip="Notifications">
            <Grid>
              <FontIcon Glyph="&#xE7E7;" FontSize="14" />
              <Border Width="7" Height="7" CornerRadius="4" Background="#E11D48"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
                      Visibility="{x:Bind ViewModel.HasUnread, Mode=OneWay}" />
            </Grid>
            <Button.Flyout>
              <Flyout x:Name="NotificationsFlyout" Placement="Bottom">
                <StackPanel Width="300" Spacing="6" Padding="2">
                  <Grid>
                    <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="13" />
                    <HyperlinkButton Content="All" HorizontalAlignment="Right"
                                     Click="OpenAllNotifications_Click" Padding="4,0" FontSize="12" />
                  </Grid>
                  <TextBlock Text="{x:Bind ViewModel.NotificationsEmpty, Mode=OneWay}"
                             FontSize="11" Opacity="0.7"
                             Visibility="{x:Bind ViewModel.ShowNotificationsEmpty, Mode=OneWay}" />
                  <ListView ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}"
                            MaxHeight="260" SelectionMode="Single"
                            IsItemClickEnabled="True" ItemClick="NotificationItem_Click">
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="ops:NotificationDto">
                        <StackPanel Spacing="1" Padding="0,3">
                          <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                          <TextBlock Text="{x:Bind Body}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"
                                     TextTrimming="CharacterEllipsis" MaxLines="2" />
                        </StackPanel>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <InfoBar Grid.Row="1" Margin="12,6,12,0"
                 IsOpen="{x:Bind ViewModel.IsBannerOpen, Mode=TwoWay}"
                 Title="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}"
                 Severity="Informational" IsClosable="True" />
        <Frame x:Name="ContentFrame" Grid.Row="2"
               Background="{ThemeResource WorkshopPageBackgroundBrush}" />
      </Grid>
    </NavigationView>

    <!-- Compact command palette -->
    <Grid Visibility="{x:Bind ViewModel.IsCommandCentreOpen, Mode=OneWay}"
          Background="#88000000"
          Tapped="CommandCentreBackdrop_Tapped">
      <Border MaxWidth="520" MaxHeight="360"
              VerticalAlignment="Top" Margin="0,56,0,0"
              HorizontalAlignment="Center"
              Background="{ThemeResource WorkshopChromeBrush}"
              BorderBrush="{ThemeResource WorkshopBorderBrush}"
              BorderThickness="1" CornerRadius="6" Padding="10"
              Tapped="CommandCentrePanel_Tapped">
        <Grid RowSpacing="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                     FontSize="11" Foreground="{ThemeResource WorkshopTextSecondaryBrush}"
                     TextWrapping="Wrap" />
          <ListView Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.SearchHits, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedSearchHit, Mode=TwoWay}"
                    IsItemClickEnabled="True"
                    ItemClick="SearchHit_ItemClick"
                    MaxHeight="300">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:SearchHitRow">
                <TextBlock Text="{x:Bind Display}" FontSize="12" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" Padding="2,5" />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
