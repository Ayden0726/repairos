<Page
    x:Class="WorkshopOS.Client.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ops="using:WorkshopOS.Contracts.Operations"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <NavigationView x:Name="NavView"
                  PaneDisplayMode="Left"
                  IsSettingsVisible="True"
                  IsBackButtonVisible="Collapsed"
                  OpenPaneLength="228"
                  CompactPaneLength="48"
                  IsPaneToggleButtonVisible="True"
                  AlwaysShowHeader="False"
                  Background="{ThemeResource WorkshopPageBackgroundBrush}"
                  ItemInvoked="NavView_ItemInvoked">
    <NavigationView.PaneHeader>
      <StackPanel Padding="12,8,12,4" Spacing="2">
        <TextBlock Text="{x:Bind ViewModel.ProductName, Mode=OneWay}" FontWeight="SemiBold" FontSize="16"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <TextBlock Text="{x:Bind ViewModel.BusinessName, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
      </StackPanel>
    </NavigationView.PaneHeader>
    <NavigationView.PaneFooter>
      <StackPanel Padding="12,8" Spacing="8">
        <TextBlock Text="{x:Bind ViewModel.UserDisplay, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
        <Button Content="Sign out" Command="{x:Bind ViewModel.LogoutCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </NavigationView.PaneFooter>
    <Grid Background="{ThemeResource WorkshopPageBackgroundBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Padding="16,12" ColumnSpacing="12" Background="{ThemeResource WorkshopChromeBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox PlaceholderText="Search tickets, customers, serials… (Ctrl+K)"
                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"
                 KeyDown="OnSearchKeyDown" />
        <Button Grid.Column="1" Content="Search" Command="{x:Bind ViewModel.SearchCommand}" />
        <Button Grid.Column="2" Content="New ticket" Click="NewTicket_Click"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Open ticket intake" />
        <Button x:Name="NotificationsButton"
                Grid.Column="3"
                Click="Notifications_Click"
                Padding="10,6"
                ToolTipService.ToolTip="Notifications">
          <Grid>
            <FontIcon Glyph="&#xE7E7;" FontSize="16" />
            <Border x:Name="UnreadBadge"
                    Width="8" Height="8"
                    CornerRadius="4"
                    Background="#E11D48"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,-2,-2,0"
                    Visibility="{x:Bind ViewModel.HasUnread, Mode=OneWay}" />
          </Grid>
          <Button.Flyout>
            <Flyout x:Name="NotificationsFlyout" Placement="Bottom">
              <StackPanel Width="340" Spacing="8" Padding="4">
                <Grid>
                  <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="14" />
                  <HyperlinkButton Content="Open all"
                                   HorizontalAlignment="Right"
                                   Click="OpenAllNotifications_Click"
                                   Padding="4,0" />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.NotificationsEmpty, Mode=OneWay}"
                           FontSize="12" Opacity="0.7"
                           Visibility="{x:Bind ViewModel.ShowNotificationsEmpty, Mode=OneWay}" />
                <ListView x:Name="NotificationsList"
                          ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}"
                          MaxHeight="320"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="NotificationItem_Click">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="ops:NotificationDto">
                      <StackPanel Spacing="2" Padding="0,4">
                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Body}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" MaxLines="2" />
                      </StackPanel>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
      <InfoBar Grid.Row="1"
               Margin="16,8,16,0"
               IsOpen="{x:Bind ViewModel.IsBannerOpen, Mode=TwoWay}"
               Title="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
               Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}"
               Severity="Informational"
               IsClosable="True" />
      <TextBlock Grid.Row="2" Margin="16,0,16,8" Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                 FontSize="12" TextWrapping="Wrap"
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
      <Frame x:Name="ContentFrame" Grid.Row="3" Background="{ThemeResource WorkshopPageBackgroundBrush}" />
    </Grid>
  </NavigationView>
</Page>
