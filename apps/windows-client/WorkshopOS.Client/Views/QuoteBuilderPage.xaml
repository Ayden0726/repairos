<Page
    x:Class="WorkshopOS.Client.Views.QuoteBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkshopOS.Client.Views"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>

    <ScrollViewer>
      <StackPanel Spacing="12" Padding="0,0,8,0">
        <Grid>
          <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource WorkshopTextPrimaryBrush}">
              <Run Text="Quote" />
              <Run Text="{x:Bind ViewModel.QuoteNumber, Mode=OneWay}" />
            </TextBlock>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Padding="8,3" CornerRadius="4" Background="{ThemeResource WorkshopAccentSoftBrush}">
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
              </Border>
              <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         Foreground="{ThemeResource WorkshopTextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <Button Content="Back to list" Click="Back_Click" HorizontalAlignment="Right" />
        </Grid>

        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock Text="Customer &amp; device" FontWeight="SemiBold"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <CheckBox Content="Existing customer"
                      IsChecked="{x:Bind ViewModel.UseExistingCustomer, Mode=TwoWay}" />
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.UseExistingCustomer, Mode=OneWay}">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Header="Search customers" Text="{x:Bind ViewModel.CustomerQuery, Mode=TwoWay}" />
                <Button Grid.Column="1" Content="Search" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.SearchCustomersCommand}" />
              </Grid>
              <ComboBox Header="Customer" ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowNewCustomerFields, Mode=OneWay}">
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Header="First name" Text="{x:Bind ViewModel.NewFirstName, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="Last name" Text="{x:Bind ViewModel.NewLastName, Mode=TwoWay}" />
              </Grid>
              <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Header="Phone" Text="{x:Bind ViewModel.NewPhone, Mode=TwoWay}" />
                <TextBox Grid.Column="1" Header="Email" Text="{x:Bind ViewModel.NewEmail, Mode=TwoWay}" />
              </Grid>
            </StackPanel>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox Header="Brand" Text="{x:Bind ViewModel.DeviceBrand, Mode=TwoWay}" />
              <TextBox Grid.Column="1" Header="Model" Text="{x:Bind ViewModel.DeviceModel, Mode=TwoWay}" />
              <TextBox Grid.Column="2" Header="Serial" Text="{x:Bind ViewModel.DeviceSerial, Mode=TwoWay}" />
            </Grid>
            <TextBox Header="Issue" Text="{x:Bind ViewModel.Issue, Mode=TwoWay}"
                     AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="10">
            <Grid>
              <TextBlock Text="Line items" FontWeight="SemiBold" VerticalAlignment="Center"
                         Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Add line" Command="{x:Bind ViewModel.AddLineCommand}" />
                <Button Content="Recalculate" Command="{x:Bind ViewModel.RecalcCommand}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:QuoteLineDraft">
                  <Border Padding="10" Margin="0,0,0,8" CornerRadius="6"
                          Background="{ThemeResource WorkshopSurfaceAltBrush}"
                          BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="Description" Text="{x:Bind Description, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Remove" VerticalAlignment="Bottom"
                                Click="RemoveLine_Click" Tag="{x:Bind}" />
                      </Grid>
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" /><ColumnDefinition Width="90" />
                          <ColumnDefinition Width="100" /><ColumnDefinition Width="100" />
                          <ColumnDefinition Width="90" /><ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="SKU / part" Text="{x:Bind Sku, Mode=TwoWay}" LostFocus="LineField_LostFocus" />
                        <NumberBox Grid.Column="1" Header="Qty" Value="{x:Bind Quantity, Mode=TwoWay}"
                                   SpinButtonPlacementMode="Compact" LostFocus="LineField_LostFocus" />
                        <NumberBox Grid.Column="2" Header="Part cost" Value="{x:Bind PartCost, Mode=TwoWay}"
                                   SpinButtonPlacementMode="Compact" LostFocus="LineField_LostFocus" />
                        <NumberBox Grid.Column="3" Header="Markup %" Value="{x:Bind MarkupPercent, Mode=TwoWay}"
                                   SpinButtonPlacementMode="Compact" LostFocus="LineField_LostFocus" />
                        <NumberBox Grid.Column="4" Header="Labour" Value="{x:Bind LabourAmount, Mode=TwoWay}"
                                   SpinButtonPlacementMode="Compact" LostFocus="LineField_LostFocus" />
                        <NumberBox Grid.Column="5" Header="Discount" Value="{x:Bind DiscountAmount, Mode=TwoWay}"
                                   SpinButtonPlacementMode="Compact" LostFocus="LineField_LostFocus" />
                      </Grid>
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PartCombo" Header="Inventory part" DisplayMemberPath="Name"
                                  HorizontalAlignment="Stretch" SelectionChanged="PartCombo_SelectionChanged"
                                  Tag="{x:Bind}" />
                        <Button Grid.Column="1" Content="Load parts" VerticalAlignment="Bottom"
                                Click="LoadParts_Click" Tag="{x:Bind}" />
                        <ComboBox Grid.Column="2" x:Name="ServiceCombo" Header="Service"
                                  DisplayMemberPath="Name" HorizontalAlignment="Stretch"
                                  SelectionChanged="ServiceCombo_SelectionChanged" Tag="{x:Bind}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
                          <Run Text="Sell " /><Run Text="{x:Bind PartSell, Mode=OneWay}" />
                          <Run Text=" · Line " /><Run Text="{x:Bind LineTotal, Mode=OneWay}" />
                        </TextBlock>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBox Header="Customer notes" Text="{x:Bind ViewModel.CustomerNotes, Mode=TwoWay}"
                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
            <TextBox Header="Internal notes" Text="{x:Bind ViewModel.InternalNotes, Mode=TwoWay}"
                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                   Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <!-- Sticky summary -->
    <Border Grid.Column="1" Padding="16" CornerRadius="8" VerticalAlignment="Top"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="Quote summary" FontSize="18" FontWeight="SemiBold"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
          <Run Text="Parts " /><Run Text="{x:Bind ViewModel.PartsSubtotal, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
          <Run Text="Labour " /><Run Text="{x:Bind ViewModel.LabourSubtotal, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
          <Run Text="Discount " /><Run Text="{x:Bind ViewModel.DiscountTotal, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
          <Run Text="Subtotal " /><Run Text="{x:Bind ViewModel.Subtotal, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
          <Run Text="Tax " /><Run Text="{x:Bind ViewModel.GstAmount, Mode=OneWay}" />
        </TextBlock>
        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{ThemeResource WorkshopTextPrimaryBrush}">
          <Run Text="Total " /><Run Text="{x:Bind ViewModel.Total, Mode=OneWay}" />
        </TextBlock>

        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CanViewProfit, Mode=OneWay}">
          <TextBlock Text="Internal profitability" FontWeight="SemiBold" Margin="0,8,0,0"
                     Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
          <TextBlock Visibility="{x:Bind ViewModel.CanViewCost, Mode=OneWay}"
                     Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
            <Run Text="Cost " /><Run Text="{x:Bind ViewModel.CostTotal, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
            <Run Text="Profit " /><Run Text="{x:Bind ViewModel.ProfitTotal, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
            <Run Text="Margin " /><Run Text="{x:Bind ViewModel.MarginPercent, Mode=OneWay}" /><Run Text="%" />
          </TextBlock>
        </StackPanel>

        <InfoBar IsOpen="{x:Bind ViewModel.RequiresApproval, Mode=OneWay}"
                 Severity="Warning" Title="Margin approval"
                 Message="{x:Bind ViewModel.MarginWarning, Mode=OneWay}"
                 IsClosable="False" />

        <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}"
                HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
        <Button Content="Send" Command="{x:Bind ViewModel.SendCommand}" HorizontalAlignment="Stretch" />
        <Button Content="Print (customer)" Command="{x:Bind ViewModel.PrintCommand}" HorizontalAlignment="Stretch" />
        <Button Content="Convert to repair" Command="{x:Bind ViewModel.ConvertCommand}" HorizontalAlignment="Stretch" />
        <ProgressRing Width="28" Height="28" HorizontalAlignment="Left"
                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
