<Page
    x:Class="WorkshopOS.Client.Views.NewRepairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="560" Spacing="12">
      <TextBlock Text="New ticket" FontSize="24" FontWeight="SemiBold"
                 Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
      <TextBlock Text="Quick intake — open a job on the board in under a minute. Device details can wait."
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
      <Border Padding="16" CornerRadius="8"
              Background="{ThemeResource WorkshopSurfaceBrush}"
              BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
        <StackPanel Spacing="12">
          <CheckBox Content="Existing customer"
                    IsChecked="{x:Bind ViewModel.UseExistingCustomer, Mode=TwoWay}" />

          <!-- Pick existing customer -->
          <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.UseExistingCustomer, Mode=OneWay}">
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Header="Search customers"
                       PlaceholderText="Name, phone, or email"
                       Text="{x:Bind ViewModel.CustomerQuery, Mode=TwoWay}"
                       KeyDown="CustomerSearch_KeyDown" />
              <Button Grid.Column="1" Content="Search" VerticalAlignment="Bottom"
                      Command="{x:Bind ViewModel.SearchCustomersCommand}"
                      IsEnabled="{x:Bind ViewModel.IsCustomersIdle, Mode=OneWay}" />
            </Grid>
            <ProgressRing Width="28" Height="28" HorizontalAlignment="Left"
                          IsActive="{x:Bind ViewModel.IsLoadingCustomers, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.CustomersStatus, Mode=OneWay}"
                       Foreground="{ThemeResource WorkshopTextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.HasCustomersStatus, Mode=OneWay}" />
            <ComboBox Header="Customer"
                      ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                      DisplayMemberPath="DisplayName"
                      HorizontalAlignment="Stretch"
                      IsEnabled="{x:Bind ViewModel.HasCustomers, Mode=OneWay}" />
          </StackPanel>

          <!-- Create new customer inline -->
          <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowNewCustomerFields, Mode=OneWay}">
            <TextBlock Text="New customer" FontWeight="SemiBold"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox Header="First name" Text="{x:Bind ViewModel.NewFirstName, Mode=TwoWay}"
                       PlaceholderText="Required" />
              <TextBox Grid.Column="1" Header="Last name" Text="{x:Bind ViewModel.NewLastName, Mode=TwoWay}" />
            </Grid>
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox Header="Phone" Text="{x:Bind ViewModel.NewPhone, Mode=TwoWay}"
                       PlaceholderText="Optional" />
              <TextBox Grid.Column="1" Header="Email" Text="{x:Bind ViewModel.NewEmail, Mode=TwoWay}"
                       PlaceholderText="Optional" />
            </Grid>
          </StackPanel>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Header="Job type" ItemsSource="{x:Bind ViewModel.Types, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedType, Mode=TwoWay}"
                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
            <ComboBox Grid.Column="1" Header="Priority" ItemsSource="{x:Bind ViewModel.Priorities, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedPriority, Mode=TwoWay}"
                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
          </Grid>
          <ComboBox Header="Assign technician (optional)" ItemsSource="{x:Bind ViewModel.Technicians, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTechnician, Mode=TwoWay}"
                    DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
          <ComboBox Header="Device type" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.DeviceTypes, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedDeviceType, Mode=TwoWay}"
                    SelectionChanged="DeviceType_SelectionChanged" />
          <TextBox x:Name="DeviceSearchBox" Header="Search device model"
                   PlaceholderText="iPhone 13 PM, S22U, SM-S908, Pixel 8 Pro…"
                   TextChanged="DeviceSearchBox_TextChanged" />
          <ComboBox x:Name="DeviceSearchResultsBox" Header="Matching models"
                    DisplayMemberPath="Display" HorizontalAlignment="Stretch"
                    PlaceholderText="Pick a match — or choose brand/model below"
                    SelectionChanged="DeviceSearchResultsBox_SelectionChanged" />
          <TextBlock Text="IMEI lookup" FontWeight="SemiBold" FontSize="16"
                     Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
          <TextBlock Text="Scan or type a 15-digit IMEI, then Lookup Device. Manual brand/model entry still works when there is no IMEI or the API is offline."
                     Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ImeiBox" Header="IMEI"
                     PlaceholderText="15 digits — barcode scanner supported"
                     Text="{x:Bind ViewModel.Imei, Mode=TwoWay}"
                     KeyDown="ImeiBox_KeyDown" />
            <Button Grid.Column="1" Content="Lookup Device" VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}" Click="ImeiLookup_Click"
                    IsEnabled="{x:Bind ViewModel.IsImeiLookupIdle, Mode=OneWay}" />
            <Button Grid.Column="2" Content="Advanced" VerticalAlignment="Bottom"
                    Click="ImeiAdvancedLookup_Click"
                    IsEnabled="{x:Bind ViewModel.IsImeiLookupIdle, Mode=OneWay}" />
          </Grid>
          <ProgressRing Width="28" Height="28" HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsLookingUpImei, Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.ImeiStatus, Mode=OneWay}"
                     Opacity="0.8" TextWrapping="Wrap"
                     Visibility="{x:Bind ViewModel.HasImeiStatus, Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.ImeiError, Mode=OneWay}"
                     Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap"
                     Visibility="{x:Bind ViewModel.HasImeiError, Mode=OneWay}" />
          <Border x:Name="ImeiResultPanel" Padding="12" CornerRadius="6"
                  Background="{ThemeResource WorkshopPageBackgroundBrush}"
                  BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1"
                  Visibility="Collapsed">
            <StackPanel Spacing="8">
              <TextBlock x:Name="ImeiResultMetaText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
              <TextBlock x:Name="ImeiDuplicatesText" Foreground="{ThemeResource WorkshopDangerBrush}"
                         TextWrapping="Wrap" FontSize="12" />
              <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox x:Name="ImeiBrandEdit" Header="Brand (editable)" />
                <TextBox x:Name="ImeiModelEdit" Grid.Column="1" Header="Model (editable)" />
                <TextBox x:Name="ImeiModelNumberEdit" Grid.Row="1" Header="Model number" />
                <TextBox x:Name="ImeiCategoryEdit" Grid.Row="1" Grid.Column="1" Header="Category" />
                <TextBox x:Name="ImeiDisplayEdit" Grid.Row="2" Header="Display" />
                <TextBox x:Name="ImeiProcessorEdit" Grid.Row="2" Grid.Column="1" Header="Processor / chipset" />
                <TextBox x:Name="ImeiBatteryEdit" Grid.Row="3" Header="Battery" />
                <TextBox x:Name="ImeiNetworkEdit" Grid.Row="3" Grid.Column="1" Header="Network" />
                <TextBox x:Name="ImeiStorageEdit" Grid.Row="4" Header="Storage (only if verified)"
                         PlaceholderText="Leave blank unless device-specific" />
                <TextBox x:Name="ImeiColourEdit" Grid.Row="4" Grid.Column="1" Header="Colour (only if verified)"
                         PlaceholderText="Leave blank unless device-specific" />
              </Grid>
              <Button Content="Apply to ticket fields" Click="ImeiApply_Click"
                      Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="BrandBox" Header="Device brand" HorizontalAlignment="Stretch"
                      IsEditable="True" PlaceholderText="Apple, Samsung… or Other"
                      SelectionChanged="BrandBox_SelectionChanged"
                      LostFocus="BrandBox_LostFocus" />
            <ComboBox x:Name="ModelBox" Grid.Column="1" Header="Model" HorizontalAlignment="Stretch"
                      IsEditable="True" PlaceholderText="Select model or Unknown / Other"
                      LostFocus="ModelBox_LostFocus" />
          </Grid>
          <TextBox Header="Serial number (optional)" Text="{x:Bind ViewModel.Serial, Mode=TwoWay}"
                   PlaceholderText="For devices without IMEI, or secondary serial" />

          <!-- Inline service catalogue — filtered by device type -->
          <TextBlock Text="Services for this device" FontWeight="SemiBold" FontSize="16"
                     Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
          <TextBlock x:Name="SvcFilterHint"
                     Text="Showing Phone services — change device type to filter for Tablet, Laptop, or PC."
                     Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
          <TextBox x:Name="SvcSearchBox" Header="Search services"
                   PlaceholderText="Type screen, SSD, battery…"
                   TextChanged="SvcSearchBox_TextChanged" />
          <ComboBox x:Name="SvcCategoryBox" Header="Category (for this device)" DisplayMemberPath="Name"
                    HorizontalAlignment="Stretch" SelectionChanged="SvcCategoryBox_SelectionChanged" />
          <ComboBox x:Name="SvcServicesBox" Header="Matching services" DisplayMemberPath="TitleLine"
                    HorizontalAlignment="Stretch" />
          <Button Content="Add selected service" Click="SvcAdd_Click"
                  Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
          <TextBlock Text="Selected services" Opacity="0.85" FontSize="12" />
          <ListView x:Name="SvcSelectedList" MaxHeight="160" SelectionMode="Single"
                    DisplayMemberPath="TitleLine" />
          <Button Content="Remove selected service" Click="SvcRemove_Click" HorizontalAlignment="Left" />
          <TextBlock Text="Parts from inventory" FontWeight="SemiBold" FontSize="16"
                     Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
          <TextBlock Text="Search stock, add custom/special-order parts when you have no stock. Multi-service tickets charge the service fee once plus parts."
                     Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="InvPartBox" Header="Search inventory" DisplayMemberPath="Name"
                      IsEditable="True" IsTextSearchEnabled="True"
                      PlaceholderText="Type SKU or part name"
                      HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Content="Load" VerticalAlignment="Bottom" Click="InvLoad_Click" />
            <Button Grid.Column="2" Content="Add stock part" VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}" Click="InvAdd_Click" />
          </Grid>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CustomPartNameBox" Header="Custom / special-order part"
                     PlaceholderText="Part name when not in stock" />
            <TextBox x:Name="CustomPartPriceBox" Grid.Column="1" Header="Sell $"
                     PlaceholderText="0.00" />
            <Button Grid.Column="2" Content="Add custom" VerticalAlignment="Bottom"
                    Click="CustomPartAdd_Click" />
          </Grid>
          <ListView x:Name="InvSelectedList" MaxHeight="160" SelectionMode="Single"
                    DisplayMemberPath="Display" />
          <Button Content="Remove selected part" Click="InvRemove_Click" HorizontalAlignment="Left" />
          <TextBox x:Name="SvcPartsBox" Header="Parts notes (optional)"
                   PlaceholderText="Extra notes not in inventory…" />
          <TextBox x:Name="SvcNotesBox" Header="Technician notes" AcceptsReturn="True"
                   Height="56" TextWrapping="Wrap" />
          <TextBlock x:Name="SvcStatusText" Opacity="0.7" TextWrapping="Wrap" />
          <TextBlock x:Name="SvcErrorText" Foreground="{ThemeResource WorkshopDangerBrush}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="InvPartsSummary" Opacity="0.8" TextWrapping="Wrap" />

          <TextBox Header="Reported fault" Text="{x:Bind ViewModel.Issue, Mode=TwoWay}"
                   AcceptsReturn="True" Height="110" TextWrapping="Wrap"
                   PlaceholderText="What is wrong? When did it start? (auto-filled from services if empty)" />
          <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
          <ProgressRing Width="28" Height="28" HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" />
          <Button Content="Create ticket" Click="CreateTicket_Click"
                  Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                  IsEnabled="{x:Bind ViewModel.CanSubmit, Mode=OneWay}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
