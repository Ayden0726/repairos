<Page x:Class="WorkshopOS.Client.Views.LoansPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="using:WorkshopOS.Contracts.Operations"
      Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="320" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="8">
      <TextBlock Text="Loan devices" FontSize="22" FontWeight="SemiBold" />
      <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.75" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      <ListView ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:LoanDeviceDto">
            <StackPanel Padding="4,8">
              <TextBlock FontWeight="SemiBold">
                <Run Text="{x:Bind AssetTag}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
              </TextBlock>
              <TextBlock FontSize="12" Opacity="0.75">
                <Run Text="{x:Bind Brand}" /><Run Text=" " /><Run Text="{x:Bind Model}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="8">
      <TextBlock Text="Agreements" FontWeight="SemiBold" FontSize="16" />
      <ListView ItemsSource="{x:Bind ViewModel.Agreements, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedAgreement, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:LoanAgreementDto">
            <StackPanel Padding="4,8">
              <TextBlock FontWeight="SemiBold">
                <Run Text="{x:Bind AssetTag}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
              </TextBlock>
              <TextBlock FontSize="12" Opacity="0.75">
                <Run Text="{x:Bind CustomerName}" /><Run Text=" · out " /><Run Text="{x:Bind CheckedOutAt}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <Button Content="Return selected" Command="{x:Bind ViewModel.ReturnCommand}" HorizontalAlignment="Stretch" />
    </StackPanel>
    <Border Grid.Column="2" Padding="16" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="Register loaner" FontWeight="SemiBold" />
        <TextBox Header="Asset tag" Text="{x:Bind ViewModel.AssetTag, Mode=TwoWay}" />
        <TextBox Header="Brand" Text="{x:Bind ViewModel.Brand, Mode=TwoWay}" />
        <TextBox Header="Model" Text="{x:Bind ViewModel.Model, Mode=TwoWay}" />
        <Button Content="Save device" Command="{x:Bind ViewModel.UpsertDeviceCommand}"
                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
        <TextBlock Text="Checkout" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBox Header="Customer Id (GUID)" Text="{x:Bind ViewModel.CheckoutCustomerId, Mode=TwoWay}" />
        <Button Content="Checkout selected device" Command="{x:Bind ViewModel.CheckoutCommand}"
                HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
