<Page
    x:Class="WorkshopOS.Client.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Background="{ThemeResource WorkshopPageBackgroundBrush}" Padding="32">
    <StackPanel MaxWidth="400" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                Background="{ThemeResource WorkshopPageBackgroundBrush}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="WorkshopOS" FontSize="28" FontWeight="SemiBold"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="ThemeLightBtn" Content="Light" Click="ThemeLight_Click" Padding="10,4" MinWidth="56" />
          <Button x:Name="ThemeDarkBtn" Content="Dark" Click="ThemeDark_Click" Padding="10,4" MinWidth="56"
                  Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
      </Grid>
      <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
      <TextBox Header="Email" Text="{x:Bind ViewModel.Email, Mode=TwoWay}" />
      <PasswordBox Header="Password" PasswordChanged="Password_PasswordChanged" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      <Button Content="Sign in" Command="{x:Bind ViewModel.LoginCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
      <HyperlinkButton Content="Change server / pairing code" Click="ChangeServer_Click" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</Page>
