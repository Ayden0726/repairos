<Page
    x:Class="WorkshopOS.Client.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Background="{ThemeResource WorkshopPageBackgroundBrush}" Padding="32">
    <StackPanel MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                Background="{ThemeResource WorkshopPageBackgroundBrush}">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="TechBench NQ" FontSize="28" FontWeight="SemiBold"
                     Foreground="{ThemeResource WorkshopAccentBrush}" />
          <TextBlock Text="Workshop sign in · Client 1.2.42" FontSize="13"
                     Foreground="{ThemeResource WorkshopTextSecondaryBrush}" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button x:Name="ThemeLightBtn" Content="Light" Click="ThemeLight_Click" Padding="10,4" MinWidth="56" />
          <Button x:Name="ThemeDarkBtn" Content="Dark" Click="ThemeDark_Click" Padding="10,4" MinWidth="56"
                  Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
      </Grid>

      <TextBlock Text="{x:Bind ViewModel.Hint, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />

      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="PinModeBtn" Content="PIN" Click="ModePin_Click" HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}" />
        <Button x:Name="PasswordModeBtn" Grid.Column="1" Content="Password" Click="ModePassword_Click"
                HorizontalAlignment="Stretch" />
      </Grid>

      <StackPanel x:Name="PasswordPanel" Spacing="12" Visibility="Collapsed">
        <TextBox x:Name="EmailBox" Header="Email" Text="{x:Bind ViewModel.Email, Mode=TwoWay}"
                 KeyDown="LoginField_KeyDown" />
        <PasswordBox x:Name="PasswordBox" Header="Password" PasswordChanged="Password_PasswordChanged"
                     KeyDown="LoginField_KeyDown" />
        <CheckBox Content="Remember email on this PC"
                  IsChecked="{x:Bind ViewModel.RememberEmail, Mode=TwoWay}" />
        <Button Content="Sign in" Command="{x:Bind ViewModel.LoginCommand}" Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Stretch" />
      </StackPanel>

      <StackPanel x:Name="PinPanel" Spacing="12">
        <TextBlock x:Name="PinDots" Text="••••" FontSize="28" FontWeight="SemiBold"
                   HorizontalAlignment="Center" CharacterSpacing="280"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <Grid ColumnSpacing="8" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Grid.Column="0" Content="1" Click="PinDigit_Click" Tag="1" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="0" Grid.Column="1" Content="2" Click="PinDigit_Click" Tag="2" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="0" Grid.Column="2" Content="3" Click="PinDigit_Click" Tag="3" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="1" Grid.Column="0" Content="4" Click="PinDigit_Click" Tag="4" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="1" Grid.Column="1" Content="5" Click="PinDigit_Click" Tag="5" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="1" Grid.Column="2" Content="6" Click="PinDigit_Click" Tag="6" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="2" Grid.Column="0" Content="7" Click="PinDigit_Click" Tag="7" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="2" Grid.Column="1" Content="8" Click="PinDigit_Click" Tag="8" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="2" Grid.Column="2" Content="9" Click="PinDigit_Click" Tag="9" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="3" Grid.Column="0" Content="Clear" Click="PinClear_Click" Height="52" HorizontalAlignment="Stretch" />
          <Button Grid.Row="3" Grid.Column="1" Content="0" Click="PinDigit_Click" Tag="0" Height="52" FontSize="20" HorizontalAlignment="Stretch" />
          <Button Grid.Row="3" Grid.Column="2" Content="Go" Click="PinGo_Click" Height="52" HorizontalAlignment="Stretch"
                  Style="{StaticResource AccentButtonStyle}" />
        </Grid>
      </StackPanel>

      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      <HyperlinkButton Content="Change server / pairing code" Click="ChangeServer_Click" HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</Page>
