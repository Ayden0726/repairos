<Page
    x:Class="WorkshopOS.Client.Views.UsedTechPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkshopOS.Client.Views"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>

    <Grid RowSpacing="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Spacing="4">
        <TextBlock Text="Refurbished" FontSize="24" FontWeight="SemiBold"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <TextBlock Text="Buy-in stock: condition, costs, asking price, and margin."
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Header="Search"
                 PlaceholderText="Brand, model, serial, IMEI…"
                 Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />
        <ComboBox Grid.Column="1" Header="Status"
                  ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" />
        <Button Grid.Column="2" Content="Refresh" VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.RefreshCommand}" />
        <Button Grid.Column="3" Content="New" VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.NewDeviceCommand}"
                Style="{StaticResource AccentButtonStyle}" />
      </Grid>

      <Grid Grid.Row="2" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
          <ProgressRing Width="28" Height="28" HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
          <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                     Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                  IsItemClickEnabled="True"
                  ItemClick="Device_ItemClick">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:UsedDeviceRowVm">
              <Grid Padding="4,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind DeviceLabel}" FontWeight="SemiBold"
                               Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                    <Border Padding="8,2" CornerRadius="4"
                            Background="{ThemeResource WorkshopAccentSoftBrush}">
                      <TextBlock Text="{x:Bind Status}" FontSize="12" />
                    </Border>
                    <Border Padding="8,2" CornerRadius="4"
                            Background="{ThemeResource WorkshopSurfaceBrush}"
                            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
                      <TextBlock Text="{x:Bind ConditionGrade}" FontSize="12" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{x:Bind SpecsLine}" FontSize="12"
                             Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
                  <TextBlock FontSize="12" Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
                    <Run Text="{x:Bind CostLine}" />
                    <Run Text=" · " />
                    <Run Text="{x:Bind SellLine}" />
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{ThemeResource WorkshopTextPrimaryBrush}"
                           Text="{x:Bind MarginLine}"
                           Visibility="{x:Bind HasMargin}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>

    <Border Grid.Column="1" Padding="16" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <ScrollViewer>
        <StackPanel Spacing="8">
          <TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="16"
                     Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />

          <TextBlock Text="Device" FontWeight="SemiBold" Opacity="0.8" Margin="0,4,0,0" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Brand" Text="{x:Bind ViewModel.Brand, Mode=TwoWay}" />
            <TextBox Grid.Column="1" Header="Model" Text="{x:Bind ViewModel.Model, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Category" PlaceholderText="Phone, Laptop…"
                     Text="{x:Bind ViewModel.Category, Mode=TwoWay}" />
            <TextBox Grid.Column="1" Header="Colour" Text="{x:Bind ViewModel.Colour, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Storage" PlaceholderText="128GB, 512GB…"
                     Text="{x:Bind ViewModel.Storage, Mode=TwoWay}" />
            <TextBox Grid.Column="1" Header="Serial" Text="{x:Bind ViewModel.Serial, Mode=TwoWay}" />
          </Grid>
          <TextBox Header="IMEI" Text="{x:Bind ViewModel.Imei, Mode=TwoWay}" />
          <TextBox Header="Other specs" Text="{x:Bind ViewModel.Specs, Mode=TwoWay}"
                   PlaceholderText="RAM, CPU, screen…" />

          <TextBlock Text="Condition &amp; status" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox Header="Condition"
                      ItemsSource="{x:Bind ViewModel.ConditionOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.Condition, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
            <ComboBox Grid.Column="1" Header="Status"
                      ItemsSource="{x:Bind ViewModel.FormStatusOptions, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <TextBlock Text="Pricing" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Purchase price" Text="{x:Bind ViewModel.PurchasePrice, Mode=TwoWay}" />
            <TextBox Grid.Column="1" Header="Parts / repair cost" Text="{x:Bind ViewModel.PartsCost, Mode=TwoWay}" />
          </Grid>
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Asking / sell price" Text="{x:Bind ViewModel.AskingPrice, Mode=TwoWay}" />
            <TextBox Grid.Column="1" Header="Actual sale (if sold)" Text="{x:Bind ViewModel.ActualSalePrice, Mode=TwoWay}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Opacity="0.75">
              <Run Text="Total cost " /><Run Text="{x:Bind ViewModel.TotalCostPreview, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
            <TextBlock Opacity="0.75" Visibility="{x:Bind ViewModel.CanViewPricing, Mode=OneWay}">
              <Run Text="Margin " /><Run Text="{x:Bind ViewModel.MarginPreview, Mode=OneWay}" FontWeight="SemiBold" />
            </TextBlock>
          </StackPanel>

          <TextBlock Text="Notes &amp; links" FontWeight="SemiBold" Opacity="0.8" Margin="0,8,0,0" />
          <TextBox Header="Supplier / source" Text="{x:Bind ViewModel.Source, Mode=TwoWay}" />
          <TextBox Header="Faults / work done" Text="{x:Bind ViewModel.Faults, Mode=TwoWay}"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
          <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}"
                   AcceptsReturn="True" TextWrapping="Wrap" Height="56" />
          <ComboBox Header="Linked customer (optional)"
                    ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch" />
          <ComboBox Header="Linked repair ticket (optional)"
                    ItemsSource="{x:Bind ViewModel.Repairs, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedRepair, Mode=TwoWay}"
                    DisplayMemberPath="Label"
                    HorizontalAlignment="Stretch" />

          <Button Content="{x:Bind ViewModel.SaveButtonLabel, Mode=OneWay}"
                  Command="{x:Bind ViewModel.SaveCommand}"
                  Style="{StaticResource AccentButtonStyle}"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{x:Bind ViewModel.CanManage, Mode=OneWay}"
                  Margin="0,8,0,0" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Page>
