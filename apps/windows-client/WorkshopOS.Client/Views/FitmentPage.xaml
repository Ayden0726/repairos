<Page x:Class="WorkshopOS.Client.Views.FitmentPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="using:WorkshopOS.Contracts.Operations"
      Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" /><ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="8">
      <TextBlock Text="Part fitment" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Which parts fit which devices — look up by brand / model before quoting."
                 Opacity="0.75" TextWrapping="Wrap" />
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox Header="Brand" Text="{x:Bind ViewModel.BrandFilter, Mode=TwoWay}" />
        <TextBox Grid.Column="1" Header="Model" Text="{x:Bind ViewModel.ModelFilter, Mode=TwoWay}" />
        <Button Grid.Column="2" Content="Search" VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.RefreshCommand}" />
      </Grid>
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.75" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:PartFitmentDto">
            <StackPanel Padding="4,8" Spacing="2">
              <TextBlock FontWeight="SemiBold" Text="{x:Bind PartName}" />
              <TextBlock FontSize="12" Opacity="0.75">
                <Run Text="{x:Bind Brand}" /><Run Text=" " /><Run Text="{x:Bind Model}" />
                <Run Text=" · " /><Run Text="{x:Bind PartSku}" /><Run Text="{x:Bind InventorySku}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
    <Border Grid.Column="1" Padding="16" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="Add fitment rule" FontWeight="SemiBold" />
        <TextBox Header="Part name" Text="{x:Bind ViewModel.PartName, Mode=TwoWay}" />
        <TextBox Header="Part SKU" Text="{x:Bind ViewModel.PartSku, Mode=TwoWay}" />
        <TextBox Header="Brand" Text="{x:Bind ViewModel.Brand, Mode=TwoWay}" />
        <TextBox Header="Model" Text="{x:Bind ViewModel.Model, Mode=TwoWay}" />
        <TextBox Header="Device type" Text="{x:Bind ViewModel.DeviceType, Mode=TwoWay}"
                 PlaceholderText="Phone, Tablet…" />
        <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}"
                 AcceptsReturn="True" Height="56" />
        <Button Content="Save rule" Command="{x:Bind ViewModel.SaveCommand}"
                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
        <Button Content="Delete selected" Command="{x:Bind ViewModel.DeleteCommand}"
                HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
