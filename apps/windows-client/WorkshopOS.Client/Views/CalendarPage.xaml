<Page
    x:Class="WorkshopOS.Client.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkshopOS.Client.Views"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>

    <Grid Grid.ColumnSpan="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock Text="Calendar" FontSize="24" FontWeight="SemiBold"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12"
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Today" Command="{x:Bind ViewModel.TodayCommand}" />
        <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
               Text="{x:Bind ViewModel.Error, Mode=OneWay}"
               Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />

    <Border Grid.Row="2" Padding="12" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <Grid RowSpacing="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="◀" Command="{x:Bind ViewModel.PrevCommand}" MinWidth="40" />
            <Button Content="▶" Command="{x:Bind ViewModel.NextCommand}" MinWidth="40" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MonthTitle, Mode=OneWay}"
                     FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
          <Button Grid.Column="2" Content="Month" Command="{x:Bind ViewModel.ShowMonthCommand}" />
          <Button Grid.Column="3" Content="Week" Command="{x:Bind ViewModel.ShowWeekCommand}" />
          <ToggleSwitch Grid.Column="4" Header="Cancelled"
                        OffContent="Hide" OnContent="Show"
                        IsOn="{x:Bind ViewModel.ShowCancelled, Mode=TwoWay}"
                        VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Sun" HorizontalAlignment="Center" Opacity="0.65" FontSize="12" />
          <TextBlock Grid.Column="1" Text="Mon" HorizontalAlignment="Center" Opacity="0.65" FontSize="12" />
          <TextBlock Grid.Column="2" Text="Tue" HorizontalAlignment="Center" Opacity="0.65" FontSize="12" />
          <TextBlock Grid.Column="3" Text="Wed" HorizontalAlignment="Center" Opacity="0.65" FontSize="12" />
          <TextBlock Grid.Column="4" Text="Thu" HorizontalAlignment="Center" Opacity="0.65" FontSize="12" />
          <TextBlock Grid.Column="5" Text="Fri" HorizontalAlignment="Center" Opacity="0.65" FontSize="12" />
          <TextBlock Grid.Column="6" Text="Sat" HorizontalAlignment="Center" Opacity="0.65" FontSize="12" />
        </Grid>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsRepeater ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}">
            <ItemsRepeater.Layout>
              <UniformGridLayout MaximumRowsOrColumns="7" Orientation="Horizontal"
                                 MinItemWidth="100" MinItemHeight="100"
                                 MinColumnSpacing="4" MinRowSpacing="4"
                                 ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
            <ItemsRepeater.ItemTemplate>
              <DataTemplate x:DataType="local:CalendarDayVm">
                <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Padding="4" Click="Day_Click" Tag="{x:Bind}"
                        Background="Transparent" BorderThickness="0">
                  <Border x:Name="DayChrome" Padding="6" CornerRadius="6" MinHeight="92"
                          Background="{ThemeResource WorkshopSurfaceAltBrush}"
                          BorderBrush="{ThemeResource WorkshopBorderBrush}"
                          BorderThickness="1">
                    <Grid RowSpacing="2">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <Grid>
                        <TextBlock Text="{x:Bind DayNumber}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                        <TextBlock HorizontalAlignment="Right" FontSize="11" Opacity="0.7"
                                   Text="{x:Bind Summary, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="72" />
                      </Grid>
                      <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Bookings}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:CalendarBookingChipVm">
                            <Border Padding="3,2" Margin="0,0,0,2" CornerRadius="3"
                                    Background="{ThemeResource WorkshopAccentSoftBrush}">
                              <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                         Foreground="{ThemeResource WorkshopTextPrimaryBrush}">
                                <Run Text="{x:Bind TimeLabel}" /><Run Text=" " />
                                <Run Text="{x:Bind Subtitle}" />
                              </TextBlock>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </Button>
              </DataTemplate>
            </ItemsRepeater.ItemTemplate>
          </ItemsRepeater>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="2" Grid.Column="1" Padding="14" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <TextBlock Text="{x:Bind ViewModel.SelectedDayLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="16"
                     Foreground="{ThemeResource WorkshopTextPrimaryBrush}" TextWrapping="Wrap" />

          <TextBlock Text="Bookings this day" FontSize="12" Opacity="0.7" />
          <ListView ItemsSource="{x:Bind ViewModel.SelectedDayBookings, Mode=OneWay}"
                    MaxHeight="160" SelectionMode="Single"
                    IsItemClickEnabled="True" ItemClick="Booking_ItemClick">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="local:CalendarBookingChipVm">
                <StackPanel Spacing="2" Padding="2">
                  <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" Opacity="0.75" Text="{x:Bind Subtitle}" />
                  <TextBlock FontSize="11" Opacity="0.6" Text="{x:Bind DetailLine}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock FontSize="12" Opacity="0.6"
                     Text="Tap a booking to edit, or schedule a new one below."
                     TextWrapping="Wrap" />

          <TextBlock Text="{x:Bind ViewModel.PanelTitle, Mode=OneWay}" FontWeight="SemiBold" FontSize="15"
                     Margin="0,8,0,0" />
          <ComboBox Header="Customer"
                    ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                    DisplayMemberPath="Label"
                    IsEditable="True" IsTextSearchEnabled="True"
                    PlaceholderText="Search customer"
                    HorizontalAlignment="Stretch" />
          <ComboBox Header="Type"
                    ItemsSource="{x:Bind ViewModel.BookingTypes, Mode=OneWay}"
                    Text="{x:Bind ViewModel.BookingType, Mode=TwoWay}"
                    IsEditable="True"
                    HorizontalAlignment="Stretch" />
          <TextBox Header="Starts (local yyyy-MM-dd HH:mm)"
                   Text="{x:Bind ViewModel.BookingStartLocal, Mode=TwoWay}" />
          <TextBox Header="Ends (local yyyy-MM-dd HH:mm)"
                   Text="{x:Bind ViewModel.BookingEndLocal, Mode=TwoWay}" />
          <TextBox Header="Notes" Text="{x:Bind ViewModel.BookingNotes, Mode=TwoWay}"
                   AcceptsReturn="True" Height="64" TextWrapping="Wrap" />

          <Button Content="Save booking" Command="{x:Bind ViewModel.SaveCommand}"
                  Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
          <Button Content="New booking" Command="{x:Bind ViewModel.NewBookingCommand}"
                  HorizontalAlignment="Stretch" />
          <Button Content="Cancel booking" Command="{x:Bind ViewModel.CancelBookingCommand}"
                  HorizontalAlignment="Stretch" />

          <ProgressRing Width="28" Height="28" HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Page>
