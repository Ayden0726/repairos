<UserControl
    x:Class="WorkshopOS.Client.Views.ServicePickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ops="using:WorkshopOS.Contracts.Operations"
    x:Name="Root">
  <StackPanel Spacing="10">
    <TextBlock Text="Service catalogue" FontWeight="SemiBold" FontSize="16"
               Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
    <TextBox x:Name="SearchBox" Header="Search services"
             PlaceholderText="Type screen, SSD, battery…"
             TextChanged="SearchBox_TextChanged"
             KeyDown="SearchBox_KeyDown" />
    <Grid ColumnSpacing="8" RowSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ComboBox x:Name="CategoryBox" Header="Category" DisplayMemberPath="Name"
                HorizontalAlignment="Stretch" SelectionChanged="CategoryBox_SelectionChanged" />
      <ComboBox x:Name="DeviceTypeBox" Grid.Column="1" Header="Device type"
                HorizontalAlignment="Stretch" SelectionChanged="DeviceTypeBox_SelectionChanged" />
      <ComboBox x:Name="BrandBox" Grid.Row="1" Header="Brand" DisplayMemberPath="Name"
                IsEditable="True" HorizontalAlignment="Stretch"
                SelectionChanged="BrandBox_SelectionChanged" />
      <ComboBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" Header="Model" DisplayMemberPath="Name"
                IsEditable="True" HorizontalAlignment="Stretch"
                SelectionChanged="ModelBox_SelectionChanged" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Clear filters" Click="ClearFilters_Click" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />

    <TextBlock Text="Quick Services" FontWeight="SemiBold" Opacity="0.85" />
    <ListView x:Name="FavList" MaxHeight="110" IsItemClickEnabled="True" ItemClick="Quick_ItemClick"
              SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="ops:CatalogueServiceDto">
          <TextBlock>
            <Run Text="{x:Bind Name}" /><Run Text=" · $" /><Run Text="{x:Bind DefaultLabourFee}" />
          </TextBlock>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <TextBlock Text="Recent" FontWeight="SemiBold" Opacity="0.85" />
    <ListView x:Name="RecentList" MaxHeight="90" IsItemClickEnabled="True" ItemClick="Quick_ItemClick"
              SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="ops:CatalogueServiceDto">
          <TextBlock Text="{x:Bind Name}" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBlock Text="Services (click to multi-select)" FontWeight="SemiBold" Opacity="0.85" />
    <ListView x:Name="ServicesList" MinHeight="140" MaxHeight="220"
              IsItemClickEnabled="True" ItemClick="ServicesList_ItemClick" SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="ops:CatalogueServiceDto">
          <Grid ColumnSpacing="8" Padding="0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" />
              <TextBlock FontSize="12" Opacity="0.7">
                <Run Text="{x:Bind Code}" /><Run Text=" · " /><Run Text="{x:Bind Subcategory}" />
                <Run Text=" · ~" /><Run Text="{x:Bind EstimatedMinutes}" /><Run Text=" min" />
              </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="1" VerticalAlignment="Center">
              <Run Text="$" /><Run Text="{x:Bind DefaultLabourFee}" />
            </TextBlock>
            <Button Grid.Column="2" Content="★" Tag="{x:Bind}" Click="Favourite_Click"
                    ToolTipService.ToolTip="Favourite" Padding="8,4" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBlock Text="Selected" FontWeight="SemiBold" Opacity="0.85" />
    <ListView x:Name="SelectedList" MinHeight="40" MaxHeight="140" SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="ops:CatalogueServiceDto">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center">
              <Run Text="{x:Bind Name}" /><Run Text=" · $" /><Run Text="{x:Bind DefaultLabourFee}" />
            </TextBlock>
            <Button Grid.Column="1" Content="Remove" Tag="{x:Bind}" Click="RemoveSelected_Click" />
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <TextBox x:Name="PartsBox" Header="Parts required (optional notes)"
             PlaceholderText="Screen assembly, adhesive…" />
    <TextBox x:Name="NotesBox" Header="Technician notes" AcceptsReturn="True" Height="56" TextWrapping="Wrap" />

    <Border Padding="10" CornerRadius="6"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1"
            Background="{ThemeResource WorkshopSurfaceBrush}">
      <StackPanel Spacing="8">
        <TextBlock Text="+ Add custom service" FontWeight="SemiBold" />
        <TextBox x:Name="CustomNameBox" Header="Name" />
        <TextBox x:Name="CustomDescBox" Header="Description" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <NumberBox x:Name="CustomLabourBox" Header="Labour" Value="50" />
          <NumberBox x:Name="CustomMinutesBox" Grid.Column="1" Header="Minutes" Value="40" />
          <Button Grid.Column="2" Content="Save to catalogue" VerticalAlignment="Bottom"
                  Click="CustomSave_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
