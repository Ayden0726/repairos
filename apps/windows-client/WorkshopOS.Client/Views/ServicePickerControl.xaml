<UserControl
    x:Class="WorkshopOS.Client.Views.ServicePickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    WinUI XamlCompiler-safe picker (1.2.20):
    - DisplayMemberPath + ItemsSource only (no template markup, no compiled binds)
    - TextBox for custom labour/minutes (parsed in code-behind)
    - Workflow: filters → services list → Add → selected list
  -->
  <StackPanel Spacing="10">
    <TextBlock Text="Service catalogue" FontWeight="SemiBold" FontSize="16"
               Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
    <TextBox x:Name="SearchBox" Header="Search services"
             PlaceholderText="Type screen, SSD, battery…"
             TextChanged="SearchBox_TextChanged"
             KeyDown="SearchBox_KeyDown" />
    <Grid ColumnSpacing="8" RowSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <ComboBox x:Name="CategoryBox" Header="Category" DisplayMemberPath="Name"
                HorizontalAlignment="Stretch" SelectionChanged="CategoryBox_SelectionChanged" />
      <ComboBox x:Name="DeviceTypeBox" Grid.Column="1" Header="Device type"
                HorizontalAlignment="Stretch" SelectionChanged="DeviceTypeBox_SelectionChanged" />
      <ComboBox x:Name="BrandBox" Grid.Row="1" Header="Brand" DisplayMemberPath="Name"
                IsEditable="True" HorizontalAlignment="Stretch"
                SelectionChanged="BrandBox_SelectionChanged" />
      <ComboBox x:Name="ModelBox" Grid.Row="1" Grid.Column="1" Header="Model" DisplayMemberPath="Name"
                IsEditable="True" HorizontalAlignment="Stretch"
                SelectionChanged="ModelBox_SelectionChanged" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Clear filters" Click="ClearFilters_Click" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />

    <ComboBox x:Name="QuickBox" Header="Quick / favourites / recent" DisplayMemberPath="TitleLine"
              HorizontalAlignment="Stretch" SelectionChanged="QuickBox_SelectionChanged" />

    <TextBlock Text="Services" FontWeight="SemiBold" Opacity="0.85" />
    <ListView x:Name="ServicesList" MinHeight="140" MaxHeight="220"
              DisplayMemberPath="TitleLine" SelectionMode="Single" />
    <Button Content="Add selected service" Click="AddSelected_Click"
            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />

    <TextBlock Text="Selected" FontWeight="SemiBold" Opacity="0.85" />
    <ListView x:Name="SelectedList" MinHeight="40" MaxHeight="140"
              DisplayMemberPath="TitleLine" SelectionMode="Single" />
    <Button Content="Remove selected" Click="RemoveSelected_Click" HorizontalAlignment="Left" />

    <TextBox x:Name="PartsBox" Header="Parts required (optional notes)"
             PlaceholderText="Screen assembly, adhesive…" />
    <TextBox x:Name="NotesBox" Header="Technician notes" AcceptsReturn="True" Height="56" TextWrapping="Wrap" />

    <Border Padding="10" CornerRadius="6"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1"
            Background="{ThemeResource WorkshopSurfaceBrush}">
      <StackPanel Spacing="8">
        <TextBlock Text="+ Add custom service" FontWeight="SemiBold" />
        <TextBox x:Name="CustomNameBox" Header="Name" />
        <TextBox x:Name="CustomDescBox" Header="Description" />
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="CustomLabourBox" Header="Labour" Text="50" />
          <TextBox x:Name="CustomMinutesBox" Grid.Column="1" Header="Minutes" Text="40" />
          <Button Grid.Column="2" Content="Save to catalogue" VerticalAlignment="Bottom"
                  Click="CustomSave_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
