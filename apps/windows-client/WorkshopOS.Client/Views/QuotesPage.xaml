<Page
    x:Class="WorkshopOS.Client.Views.QuotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ops="using:WorkshopOS.Contracts.Operations"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel Spacing="4">
        <TextBlock Text="Quotes" FontSize="24" FontWeight="SemiBold"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <TextBlock Text="Repair quotes with automatic pricing, margin checks, and customer print."
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Content="New quote" Click="NewQuote_Click" HorizontalAlignment="Right"
              Style="{StaticResource AccentButtonStyle}" />
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="160" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox Header="Search" PlaceholderText="Number, customer, device…"
               Text="{x:Bind ViewModel.Query, Mode=TwoWay}" />
      <ComboBox Grid.Column="1" Header="Status" SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}"
                HorizontalAlignment="Stretch">
        <x:String>All</x:String>
        <x:String>Draft</x:String>
        <x:String>Sent</x:String>
        <x:String>Accepted</x:String>
        <x:String>Declined</x:String>
        <x:String>Expired</x:String>
        <x:String>Converted</x:String>
      </ComboBox>
      <Button Grid.Column="2" Content="Refresh" VerticalAlignment="Bottom"
              Command="{x:Bind ViewModel.RefreshCommand}" />
    </Grid>
    <Grid Grid.Row="2" RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Spacing="4">
        <ProgressRing Width="28" Height="28" HorizontalAlignment="Left"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                   Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                IsItemClickEnabled="True" ItemClick="Quotes_ItemClick">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:QuoteListItemDto">
            <Grid Padding="4,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{x:Bind Number}" FontWeight="SemiBold"
                             Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                  <Border Padding="8,2" CornerRadius="4"
                          Background="{ThemeResource WorkshopAccentSoftBrush}">
                    <TextBlock Text="{x:Bind Status}" FontSize="12" />
                  </Border>
                </StackPanel>
                <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
                  <Run Text="{x:Bind CustomerName}" /><Run Text=" · Rev " /><Run Text="{x:Bind RevisionNumber}" />
                </TextBlock>
              </StackPanel>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                         Foreground="{ThemeResource WorkshopTextPrimaryBrush}"
                         Text="{x:Bind Total}" />
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>
  </Grid>
</Page>
