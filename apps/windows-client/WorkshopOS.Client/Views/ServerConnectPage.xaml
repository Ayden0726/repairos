<Page
    x:Class="WorkshopOS.Client.Views.ServerConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource WorkshopPageBackgroundBrush}" Padding="32">
    <StackPanel MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
      <TextBlock Text="WorkshopOS" FontSize="28" FontWeight="SemiBold" />
      <Border Background="#1A0B6E4F" Padding="10,6" CornerRadius="4" HorizontalAlignment="Left">
        <TextBlock Text="Client 1.2.7" FontSize="14" FontWeight="SemiBold" Foreground="#0B6E4F" />
      </Border>
      <TextBlock Text="Connect to your shop server on this Wi‑Fi / LAN." Opacity="0.75" TextWrapping="Wrap" />

      <TextBox Header="Pairing code (from http://server:5088/connect)"
               Text="{x:Bind ViewModel.PairingCode, Mode=TwoWay}"
               PlaceholderText="WOS-XXXX" />
      <Button Content="Connect with code" Command="{x:Bind ViewModel.ConnectWithCodeCommand}"
              Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />

      <Button Content="Find on this network" Command="{x:Bind ViewModel.FindOnNetworkCommand}"
              HorizontalAlignment="Stretch" />

      <TextBlock Text="— or enter URL manually —" Opacity="0.5" HorizontalAlignment="Center" FontSize="12" />
      <TextBox Header="Server URL" Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay}"
               PlaceholderText="http://192.168.1.50:5088" />
      <Button Content="Connect" Command="{x:Bind ViewModel.ConnectCommand}" HorizontalAlignment="Stretch" />

      <HyperlinkButton Content="Clear saved server" Click="ClearSaved_Click" HorizontalAlignment="Center" />

      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="DarkRed" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" />
      <ListView ItemsSource="{x:Bind ViewModel.FoundServers, Mode=OneWay}" MaxHeight="120"
                IsItemClickEnabled="True" ItemClick="FoundServer_Click" />
    </StackPanel>
  </Grid>
</Page>
