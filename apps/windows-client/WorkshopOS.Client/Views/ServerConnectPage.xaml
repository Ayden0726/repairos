<Page
    x:Class="WorkshopOS.Client.Views.ServerConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="32">
    <StackPanel MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
      <TextBlock Text="WorkshopOS" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Connect to your WorkshopOS server on this network" Opacity="0.75" TextWrapping="Wrap" />

      <TextBox Header="Pairing code"
               Text="{x:Bind ViewModel.PairingCode, Mode=TwoWay}"
               PlaceholderText="WOS-XXXX"
               MaxLength="12" />
      <Button Content="Connect with code"
              Command="{x:Bind ViewModel.ConnectWithCodeCommand}"
              Style="{StaticResource AccentButtonStyle}"
              HorizontalAlignment="Stretch" />
      <Button Content="Find on this network"
              Command="{x:Bind ViewModel.DiscoverCommand}"
              HorizontalAlignment="Stretch" />

      <TextBlock Text="Or enter the server URL manually" Opacity="0.55" Margin="0,8,0,0" />
      <TextBox Header="Server URL"
               Text="{x:Bind ViewModel.ServerUrl, Mode=TwoWay}"
               PlaceholderText="http://192.168.1.50:5088" />
      <Button Content="Connect with URL"
              Command="{x:Bind ViewModel.ConnectCommand}"
              HorizontalAlignment="Stretch" />

      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="DarkRed" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Page>
