<Page x:Class="WorkshopOS.Client.Views.StocktakePage"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="using:WorkshopOS.Contracts.Operations"
      xmlns:local="using:WorkshopOS.Client.Views"
      Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="8">
      <TextBlock Text="Stocktake" FontSize="22" FontWeight="SemiBold"
                 Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
      <TextBlock Text="Count every SKU, then complete to apply variances to on-hand stock."
                 Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
      <TextBox Header="Notes (optional)" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}" />
      <Button Content="Start stocktake" Command="{x:Bind ViewModel.StartCommand}"
              Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
      <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Stretch" />
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      <ListView ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:StocktakeListItemDto">
            <StackPanel Spacing="2" Padding="4,8">
              <TextBlock FontWeight="SemiBold">
                <Run Text="{x:Bind Number}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
              </TextBlock>
              <TextBlock FontSize="12" Opacity="0.75">
                <Run Text="{x:Bind CountedLines}" /><Run Text="/" /><Run Text="{x:Bind LineCount}" /><Run Text=" counted" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
    <Border Grid.Column="1" Padding="16" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{x:Bind ViewModel.DetailHeader, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Complete &amp; apply" Command="{x:Bind ViewModel.CompleteCommand}"
                  Style="{StaticResource AccentButtonStyle}"
                  IsEnabled="{x:Bind ViewModel.SessionOpen, Mode=OneWay}" />
          <Button Content="Cancel session" Command="{x:Bind ViewModel.CancelCommand}"
                  IsEnabled="{x:Bind ViewModel.SessionOpen, Mode=OneWay}" />
        </StackPanel>
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:StocktakeLineRowVm">
              <Grid Padding="4,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="70" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="{x:Bind Sku}" /><Run Text=" · " /><Run Text="{x:Bind Name}" />
                  </TextBlock>
                  <TextBlock FontSize="12" Opacity="0.75">
                    <Run Text="Expected " /><Run Text="{x:Bind ExpectedQty}" />
                    <Run Text=" · bin " /><Run Text="{x:Bind LocationBin}" />
                  </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Opacity="0.75"
                           Text="{x:Bind VarianceLabel, Mode=OneWay}" />
                <TextBox Grid.Column="2" Header="Count"
                         Text="{x:Bind CountedText, Mode=TwoWay}" />
                <Button Grid.Column="3" Content="Save" VerticalAlignment="Bottom"
                        Tag="{x:Bind}" Click="SaveCount_Click" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>
  </Grid>
</Page>
