<Page
    x:Class="WorkshopOS.Client.Views.PcBuildBuilderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkshopOS.Client.Views"
    xmlns:ops="using:WorkshopOS.Contracts.Operations"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="2*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <ScrollViewer>
      <StackPanel Spacing="12" Padding="0,0,8,0">
        <Grid>
          <StackPanel Spacing="4">
            <TextBlock FontSize="24" FontWeight="SemiBold"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}"
                       Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.BuildNumber, Mode=OneWay}"
                       Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
          </StackPanel>
          <Button Content="Back to list" Click="Back_Click" HorizontalAlignment="Right" />
        </Grid>

        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock Text="Build details" FontWeight="SemiBold"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox Header="Name" PlaceholderText="Gaming PC, office workstation…"
                       Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
              <ComboBox Grid.Column="1" Header="Status"
                        ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
            </Grid>
            <ComboBox Header="Customer"
                      ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                      DisplayMemberPath="Label"
                      HorizontalAlignment="Stretch" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox Header="Use case" Text="{x:Bind ViewModel.UseCase, Mode=TwoWay}" />
              <TextBox Grid.Column="1" Header="Budget" Text="{x:Bind ViewModel.Budget, Mode=TwoWay}" />
            </Grid>
            <TextBox Header="Notes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="64" />
          </StackPanel>
        </Border>

        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="10">
            <Grid>
              <TextBlock Text="Component slots" FontWeight="SemiBold"
                         Foreground="{ThemeResource WorkshopTextPrimaryBrush}"
                         VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button Content="+ RAM" Command="{x:Bind ViewModel.AddRamLineCommand}" />
                <Button Content="+ Storage" Command="{x:Bind ViewModel.AddStorageLineCommand}" />
                <Button Content="+ Other" Command="{x:Bind ViewModel.AddOtherLineCommand}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Pick in-stock inventory filtered by component type. Reserved stock is hidden."
                       Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Slots, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:PcBuildSlotLine">
                  <Border Padding="10" Margin="0,0,0,8" CornerRadius="6"
                          Background="{ThemeResource WorkshopPageBackgroundBrush}"
                          BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                      <Grid>
                        <TextBlock Text="{x:Bind Category}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                        <Button Content="Clear" HorizontalAlignment="Right"
                                Click="ClearSlot_Click" Tag="{x:Bind}" />
                      </Grid>
                      <ComboBox Header="Inventory part"
                                ItemsSource="{x:Bind Options, Mode=OneWay}"
                                SelectedItem="{x:Bind SelectedItem, Mode=TwoWay}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="ops:InventoryListItemDto">
                            <TextBlock>
                              <Run Text="{x:Bind Sku}" FontWeight="SemiBold" />
                              <Run Text=" · " />
                              <Run Text="{x:Bind Name}" />
                              <Run Text=" · avail " />
                              <Run Text="{x:Bind Available}" />
                              <Run Text=" · $" />
                              <Run Text="{x:Bind Cost}" />
                              <Run Text=" / $" />
                              <Run Text="{x:Bind SellPrice}" />
                            </TextBlock>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="80" />
                          <ColumnDefinition Width="100" />
                          <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="Label" Text="{x:Bind ManualName, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Header="Qty" Text="{x:Bind QuantityText, Mode=TwoWay}"
                                 LostFocus="SlotField_Changed" />
                        <TextBox Grid.Column="2" Header="Cost" Text="{x:Bind CostText, Mode=TwoWay}"
                                 LostFocus="SlotField_Changed" />
                        <TextBox Grid.Column="3" Header="Sell" Text="{x:Bind SellText, Mode=TwoWay}"
                                 LostFocus="SlotField_Changed" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" Padding="16" CornerRadius="8" VerticalAlignment="Top"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="Summary" FontWeight="SemiBold" FontSize="16"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <StackPanel Spacing="4">
          <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
            <Run Text="Parts cost" />
          </TextBlock>
          <TextBlock Text="{x:Bind ViewModel.CostTotalLabel, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                     Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
          <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}" Margin="0,8,0,0">
            <Run Text="Sell total" />
          </TextBlock>
          <TextBlock Text="{x:Bind ViewModel.SellTotalLabel, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                     Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
          <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}" Margin="0,8,0,0">
            <Run Text="Margin" />
          </TextBlock>
          <TextBlock Text="{x:Bind ViewModel.MarginLabel, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"
                     Foreground="{ThemeResource WorkshopAccentBrush}" />
        </StackPanel>

        <ProgressRing Width="28" Height="28" HorizontalAlignment="Left"
                      IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                   Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />

        <Button Content="Recalculate" Command="{x:Bind ViewModel.RecalcSummaryCommand}"
                HorizontalAlignment="Stretch" />
        <Button Content="Save &amp; reserve parts" Command="{x:Bind ViewModel.SaveCommand}"
                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
        <Button Content="Mark completed (consume)" Click="Complete_Click"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsExisting, Mode=OneWay}" />
        <Button Content="Mark sold (consume)" Click="Sold_Click"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsExisting, Mode=OneWay}" />
        <Button Content="Cancel build (release)" Command="{x:Bind ViewModel.CancelBuildCommand}"
                HorizontalAlignment="Stretch"
                Visibility="{x:Bind ViewModel.IsExisting, Mode=OneWay}" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
