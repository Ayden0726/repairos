<Page
    x:Class="WorkshopOS.Client.Views.RepairDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:w="using:WorkshopOS.Contracts.Workshop"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <ScrollViewer Padding="24">
    <Grid ColumnSpacing="20" MaxWidth="1100">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Spacing="12">
        <Grid>
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{x:Bind ViewModel.Repair.TicketNumber, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"
                         Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
              <Border Padding="8,3" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource WorkshopAccentSoftBrush}">
                <TextBlock Text="{x:Bind ViewModel.Repair.StatusName, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" />
              </Border>
              <Border Padding="8,3" CornerRadius="4" VerticalAlignment="Center"
                      Background="{ThemeResource WorkshopSurfaceAltBrush}"
                      BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
                <TextBlock Text="{x:Bind ViewModel.Repair.PriorityName, Mode=OneWay}" FontSize="12" />
              </Border>
            </StackPanel>
            <TextBlock FontSize="16" Foreground="{ThemeResource WorkshopTextPrimaryBrush}">
              <Run Text="{x:Bind ViewModel.Repair.CustomerName, Mode=OneWay}" />
              <Run Text=" · " />
              <Run Text="{x:Bind ViewModel.Repair.TypeName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}"
                       Text="{x:Bind ViewModel.Repair.DeviceLabel, Mode=OneWay}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Create Quote" Click="CreateQuote_Click" Style="{StaticResource AccentButtonStyle}" />
            <Button Content="Customer" Click="OpenCustomer_Click" />
            <Button Content="Print job sheet" Click="Print_Click" />
          </StackPanel>
        </Grid>

        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="Reported fault"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.Repair.ReportedIssue, Mode=OneWay}" TextWrapping="Wrap"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <TextBlock FontSize="12" Foreground="{ThemeResource WorkshopTextSecondaryBrush}" Margin="0,4,0,0"
                       Text="{x:Bind ViewModel.AccessoriesSummary, Mode=OneWay}" />
          </StackPanel>
        </Border>

        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="Diagnosis"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <TextBox Header="Diagnosis" Text="{x:Bind ViewModel.Diagnosis, Mode=TwoWay}"
                     AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
            <TextBox Header="Recommended repair" Text="{x:Bind ViewModel.Recommended, Mode=TwoWay}"
                     AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
            <Button Content="Save diagnosis" Command="{x:Bind ViewModel.SaveDiagnosisCommand}" />
          </StackPanel>
        </Border>

        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="Notes timeline"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <TextBox Header="Add note" Text="{x:Bind ViewModel.NoteBody, Mode=TwoWay}"
                     AcceptsReturn="True" Height="70" TextWrapping="Wrap"
                     PlaceholderText="Update for the bench or the customer…" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <CheckBox Content="Internal only (not customer-facing)"
                        IsChecked="{x:Bind ViewModel.NoteIsInternal, Mode=TwoWay}" />
              <Button Grid.Column="1" Content="Add note" Command="{x:Bind ViewModel.AddNoteCommand}"
                      Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Repair.Notes, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="w:RepairNoteDto">
                  <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="6"
                          Background="{ThemeResource WorkshopSurfaceAltBrush}"
                          BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="2">
                      <Grid>
                        <TextBlock FontSize="12" Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
                          <Run Text="{x:Bind AuthorName}" /><Run Text=" · " /><Run Text="{x:Bind CreatedAt}" />
                        </TextBlock>
                        <Border HorizontalAlignment="Right" Padding="6,1" CornerRadius="3"
                                Background="{ThemeResource WorkshopAccentSoftBrush}"
                                Visibility="{x:Bind IsInternal}">
                          <TextBlock Text="Internal" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{x:Bind Body}" TextWrapping="Wrap"
                                 Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Padding="14" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="Activity timeline"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Repair.Timeline, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="w:RepairEventDto">
                  <Grid Margin="0,4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="11" Text="{x:Bind CreatedAt}"
                               Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Summary}" TextWrapping="Wrap"
                               Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="1" Spacing="12">
        <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock FontWeight="SemiBold" Text="Status workflow"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <TextBlock Foreground="{ThemeResource WorkshopTextSecondaryBrush}" FontSize="12"
                       Text="Move the job through the bench pipeline." />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Statuses, Mode=OneWay}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="w:LookupDto">
                  <Button Content="{x:Bind Name}" Margin="0,0,6,6" MinWidth="120"
                          Tag="{x:Bind Id}" Click="StatusChip_Click" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ComboBox Header="Or pick status" ItemsSource="{x:Bind ViewModel.Statuses, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
            <Button Content="Update status" Command="{x:Bind ViewModel.SaveStatusCommand}"
                    HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
          </StackPanel>
        </Border>

        <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="10">
            <TextBlock FontWeight="SemiBold" Text="Assignment &amp; priority"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <ComboBox Header="Technician" ItemsSource="{x:Bind ViewModel.Technicians, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedTechnician, Mode=TwoWay}"
                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
            <Button Content="Save assignment" Command="{x:Bind ViewModel.SaveAssignCommand}"
                    HorizontalAlignment="Stretch" />
            <ComboBox Header="Priority" ItemsSource="{x:Bind ViewModel.Priorities, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedPriority, Mode=TwoWay}"
                      DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
            <Button Content="Save priority" Command="{x:Bind ViewModel.SavePriorityCommand}"
                    HorizontalAlignment="Stretch" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                       Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="16" CornerRadius="8"
                Background="{ThemeResource WorkshopSurfaceBrush}"
                BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="Ticket details"
                       Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
            <TextBlock FontSize="12" Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
              <Run Text="Created: " /><Run Text="{x:Bind ViewModel.Repair.CreatedAt, Mode=OneWay}" />
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
              <Run Text="Due: " /><Run Text="{x:Bind ViewModel.Repair.DueAt, Mode=OneWay}" />
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
              <Run Text="Assigned: " /><Run Text="{x:Bind ViewModel.Repair.AssignedToName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock FontSize="12" Foreground="{ThemeResource WorkshopTextSecondaryBrush}">
              <Run Text="Estimate: " /><Run Text="{x:Bind ViewModel.Repair.EstimatedPrice, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Page>
