<Page
    x:Class="WorkshopOS.Client.Views.RepairDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:w="using:WorkshopOS.Contracts.Workshop">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="720" Spacing="10">
      <TextBlock Text="{x:Bind ViewModel.Repair.TicketNumber, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{x:Bind ViewModel.Repair.CustomerName, Mode=OneWay}" />
      <TextBlock Text="{x:Bind ViewModel.Repair.DeviceLabel, Mode=OneWay}" Opacity="0.75" />
      <TextBlock Text="{x:Bind ViewModel.Repair.ReportedIssue, Mode=OneWay}" TextWrapping="Wrap" />
      <ComboBox Header="Status" ItemsSource="{x:Bind ViewModel.Statuses, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedStatus, Mode=TwoWay}"
                DisplayMemberPath="Name" HorizontalAlignment="Left" Width="280" />
      <Button Content="Update status" Command="{x:Bind ViewModel.SaveStatusCommand}" />
      <TextBox Header="Add note" Text="{x:Bind ViewModel.NoteBody, Mode=TwoWay}" />
      <Button Content="Save note" Command="{x:Bind ViewModel.AddNoteCommand}" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="DarkRed" />
      <TextBlock Text="Timeline" FontWeight="SemiBold" Margin="0,12,0,0" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Repair.Timeline, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="w:RepairEventDto">
            <TextBlock Margin="0,4" Text="{x:Bind Summary}" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</Page>
