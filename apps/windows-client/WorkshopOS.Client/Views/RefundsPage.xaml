<Page x:Class="WorkshopOS.Client.Views.RefundsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="using:WorkshopOS.Contracts.Operations"
      Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" /><ColumnDefinition Width="340" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="8">
      <TextBlock Text="Refund approvals" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Submit and decide refund requests against invoices or POS sales."
                 Opacity="0.75" TextWrapping="Wrap" />
      <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.75" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:RefundRequestDto">
            <StackPanel Padding="4,8">
              <TextBlock FontWeight="SemiBold">
                <Run Text="{x:Bind Number}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
                <Run Text=" · $" /><Run Text="{x:Bind Amount}" />
              </TextBlock>
              <TextBlock FontSize="12" Opacity="0.75" Text="{x:Bind Reason}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Approve" Command="{x:Bind ViewModel.ApproveCommand}" Style="{StaticResource AccentButtonStyle}" />
        <Button Content="Reject" Command="{x:Bind ViewModel.RejectCommand}" />
      </StackPanel>
    </StackPanel>
    <Border Grid.Column="1" Padding="16" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="New refund request" FontWeight="SemiBold" />
        <TextBox Header="Invoice Id" Text="{x:Bind ViewModel.InvoiceId, Mode=TwoWay}" />
        <TextBox Header="POS sale Id" Text="{x:Bind ViewModel.PosSaleId, Mode=TwoWay}" />
        <TextBox Header="Amount (AUD)" Text="{x:Bind ViewModel.Amount, Mode=TwoWay}" />
        <TextBox Header="Reason" Text="{x:Bind ViewModel.Reason, Mode=TwoWay}"
                 AcceptsReturn="True" Height="72" TextWrapping="Wrap" />
        <Button Content="Submit" Command="{x:Bind ViewModel.CreateCommand}"
                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
