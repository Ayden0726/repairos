<Page x:Class="WorkshopOS.Client.Views.PosPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="using:WorkshopOS.Contracts.Operations"
      Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.2*" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="1.1*" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.ColumnSpan="3" Spacing="4">
      <TextBlock Text="POS" FontSize="22" FontWeight="SemiBold"
                 Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Catalogue -->
    <Border Grid.Row="1" Padding="12" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
          <TextBlock Text="Stock" FontWeight="SemiBold" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Search SKU / name" Text="{x:Bind ViewModel.ProductQuery, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="Refresh" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.RefreshProductsCommand}" />
          </Grid>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Products, Mode=OneWay}"
                  IsItemClickEnabled="True" ItemClick="Product_ItemClick">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="ops:InventoryListItemDto">
              <StackPanel Padding="4,6" Spacing="2">
                <TextBlock>
                  <Run Text="{x:Bind Sku}" FontWeight="Bold" /><Run Text=" · " /><Run Text="{x:Bind Name}" />
                </TextBlock>
                <TextBlock FontSize="12" Opacity="0.7">
                  <Run Text="avail " /><Run Text="{x:Bind Available}" />
                  <Run Text=" · $" /><Run Text="{x:Bind SellPrice}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,8,0,0">
          <TextBlock Text="Import repair" FontWeight="SemiBold" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Ticket / customer" Text="{x:Bind ViewModel.RepairQuery, Mode=TwoWay}"
                     PlaceholderText="REP-… or name" />
            <Button Grid.Column="1" Content="Find" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.SearchRepairsCommand}" />
          </Grid>
          <ListView ItemsSource="{x:Bind ViewModel.PayableRepairs, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedRepair, Mode=TwoWay}"
                    MaxHeight="160">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="ops:PosPayableRepairDto">
                <StackPanel Padding="2,6" Spacing="2">
                  <TextBlock>
                    <Run Text="{x:Bind TicketNumber}" FontWeight="Bold" />
                    <Run Text=" · " /><Run Text="{x:Bind CustomerName}" />
                  </TextBlock>
                  <TextBlock FontSize="12" Opacity="0.7">
                    <Run Text="bal $" /><Run Text="{x:Bind Balance}" />
                    <Run Text=" · " /><Run Text="{x:Bind StatusName}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock Text="{x:Bind ViewModel.SelectedRepairLabel, Mode=OneWay}"
                     Opacity="0.8" TextWrapping="Wrap" FontSize="12" />
          <Button Content="Clear repair" HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.ClearRepairCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Cart -->
    <Border Grid.Row="1" Grid.Column="1" Padding="12" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <Grid RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Cart" FontWeight="SemiBold" />
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Cart, Mode=OneWay}">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:PosCartLine" xmlns:local="using:WorkshopOS.Client.Views">
              <Grid Padding="2,6" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" Opacity="0.7"
                             Text="{x:Bind QtyPriceLabel}" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Tag="{x:Bind}" Click="RemoveCart_Click" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Spacing="8">
          <TextBlock FontWeight="SemiBold" FontSize="18"
                     Text="{x:Bind ViewModel.CartTotalLabel, Mode=OneWay}" />
          <TextBox Header="Custom line description" Text="{x:Bind ViewModel.CustomDescription, Mode=TwoWay}" />
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Header="Price" Text="{x:Bind ViewModel.CustomPrice, Mode=TwoWay}" />
            <TextBox Grid.Column="1" Header="Qty" Text="{x:Bind ViewModel.CustomQty, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="Add" VerticalAlignment="Bottom"
                    Command="{x:Bind ViewModel.AddCustomLineCommand}" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Pay + history -->
    <Border Grid.Row="1" Grid.Column="2" Padding="12" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock Text="Checkout" FontWeight="SemiBold" />
          <ComboBox Header="Payment method" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.PaymentMethods, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PaymentMethod, Mode=TwoWay}" />
          <ComboBox Header="Discount" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.DiscountOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedDiscount, Mode=TwoWay}"
                    DisplayMemberPath="Display" />
          <TextBox Header="Custom discount %"
                   Text="{x:Bind ViewModel.CustomDiscountPercent, Mode=TwoWay}"
                   PlaceholderText="Overrides preset when set" />
          <ComboBox Header="Pay mode (repairs)" HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.PayModes, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PayMode, Mode=TwoWay}" />
          <TextBox Header="Deposit amount"
                   Text="{x:Bind ViewModel.DepositAmount, Mode=TwoWay}"
                   PlaceholderText="Required for deposit" />
          <TextBox Header="EFTPOS / provider reference"
                   PlaceholderText="Approval code or RRN"
                   Text="{x:Bind ViewModel.ProviderReference, Mode=TwoWay}" />
          <TextBox Header="Notes (optional)" Text="{x:Bind ViewModel.Notes, Mode=TwoWay}" />
          <TextBlock Text="{x:Bind ViewModel.ProviderHint, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
          <Button Content="Complete sale" Style="{StaticResource AccentButtonStyle}"
                  HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.CompleteSaleCommand}" />
          <Button Content="Clear cart" HorizontalAlignment="Stretch"
                  Command="{x:Bind ViewModel.ClearCartCommand}" />

          <TextBlock Text="Today’s sales" FontWeight="SemiBold" Margin="0,12,0,0" />
          <Button Content="Refresh sales" Command="{x:Bind ViewModel.RefreshSalesCommand}" />
          <ListView ItemsSource="{x:Bind ViewModel.Sales, Mode=OneWay}" MaxHeight="280">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="ops:PosSaleListItemDto">
                <StackPanel Padding="2,6" Spacing="2">
                  <TextBlock>
                    <Run Text="{x:Bind Number}" FontWeight="Bold" />
                    <Run Text=" · $" /><Run Text="{x:Bind Total}" />
                  </TextBlock>
                  <TextBlock FontSize="12" Opacity="0.7">
                    <Run Text="{x:Bind PaymentMethod}" />
                    <Run Text=" · " /><Run Text="{x:Bind CustomerName}" />
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</Page>
