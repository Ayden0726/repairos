<Page
    x:Class="WorkshopOS.Client.Views.RepairsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:w="using:WorkshopOS.Contracts.Workshop"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel Spacing="2">
        <TextBlock Text="Tickets" FontSize="24" FontWeight="SemiBold"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12"
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
        <Button Content="New ticket" Click="NewRepair_Click" Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Padding="12" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <Grid ColumnSpacing="8" RowSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox PlaceholderText="Search ticket #, customer, serial, fault…"
                 Text="{x:Bind ViewModel.Query, Mode=TwoWay}"
                 KeyDown="Query_KeyDown" />
        <ComboBox Grid.Column="1" Header="Status"
                  ItemsSource="{x:Bind ViewModel.StatusFilterLabels, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedStatusLabel, Mode=TwoWay}"
                  SelectionChanged="Filter_Changed" HorizontalAlignment="Stretch" />
        <ComboBox Grid.Column="2" Header="Priority"
                  ItemsSource="{x:Bind ViewModel.PriorityFilterLabels, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedPriorityLabel, Mode=TwoWay}"
                  SelectionChanged="Filter_Changed" HorizontalAlignment="Stretch" />
        <ComboBox Grid.Column="3" Header="Technician"
                  ItemsSource="{x:Bind ViewModel.TechnicianFilterLabels, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.SelectedTechnicianLabel, Mode=TwoWay}"
                  SelectionChanged="Filter_Changed" HorizontalAlignment="Stretch" />
        <CheckBox Grid.Column="4" Content="Overdue" VerticalAlignment="Bottom"
                  IsChecked="{x:Bind ViewModel.OverdueOnly, Mode=TwoWay}"
                  Checked="Overdue_Changed" Unchecked="Overdue_Changed" />
        <Button Grid.Column="5" Content="Apply" VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.RefreshCommand}" Style="{StaticResource AccentButtonStyle}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="2" Spacing="4">
      <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="28" Height="28" HorizontalAlignment="Left" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                 Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="3" Padding="12,6,12,6" ColumnSpacing="12"
          Background="{ThemeResource WorkshopSurfaceAltBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="100" />
        <ColumnDefinition Width="120" />
        <ColumnDefinition Width="100" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="Ticket" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
      <TextBlock Grid.Column="1" Text="Customer / device / fault" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
      <TextBlock Grid.Column="2" Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
      <TextBlock Grid.Column="3" Text="Priority" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
      <TextBlock Grid.Column="4" Text="Technician" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
      <TextBlock Grid.Column="5" Text="Due" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
    </Grid>

    <ListView Grid.Row="4" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
              IsItemClickEnabled="True" ItemClick="Repair_ItemClick"
              SelectionMode="None"
              Background="{ThemeResource WorkshopPageBackgroundBrush}">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="w:RepairListItemDto">
          <Border Padding="12,10"
                  Background="{ThemeResource WorkshopSurfaceBrush}"
                  BorderBrush="{ThemeResource WorkshopBorderBrush}"
                  BorderThickness="1" CornerRadius="6">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="100" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="{x:Bind TicketNumber}" FontWeight="SemiBold"
                           Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                <TextBlock FontSize="11" Text="{x:Bind TypeName}"
                           Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Bind CustomerName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
                <TextBlock FontSize="12" Text="{x:Bind DeviceLabel}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
                <TextBlock FontSize="12" Text="{x:Bind ReportedIssue}" TextTrimming="CharacterEllipsis" MaxLines="1"
                           Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
              </StackPanel>
              <Border Grid.Column="2" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center"
                      CornerRadius="4" Background="{ThemeResource WorkshopAccentSoftBrush}">
                <TextBlock Text="{x:Bind StatusName}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
              </Border>
              <TextBlock Grid.Column="3" Text="{x:Bind PriorityName}" VerticalAlignment="Center"
                         Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
              <TextBlock Grid.Column="4" Text="{x:Bind AssignedToName}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
              <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontSize="12" Text="{x:Bind DueAt}"
                           Foreground="{ThemeResource WorkshopTextSecondaryBrush}" />
                <TextBlock FontSize="11" Text="OVERDUE" FontWeight="SemiBold"
                           Foreground="{ThemeResource WorkshopOverdueBrush}"
                           Visibility="{x:Bind IsOverdue}" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
