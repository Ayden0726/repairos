<Page x:Class="WorkshopOS.Client.Views.WarrantyClaimsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="using:WorkshopOS.Contracts.Operations"
      Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Padding="24" ColumnSpacing="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="8">
      <TextBlock Text="Warranties" FontSize="22" FontWeight="SemiBold" />
      <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.75" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
      <ListView ItemsSource="{x:Bind ViewModel.Warranties, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedWarranty, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:StaffWarrantyDto">
            <StackPanel Padding="4,8">
              <TextBlock FontWeight="SemiBold" Text="{x:Bind CustomerName}" />
              <TextBlock FontSize="12" Opacity="0.75">
                <Run Text="{x:Bind CoverageSummary}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
                <Run Text=" · exp " /><Run Text="{x:Bind ExpiresAt}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="8">
      <TextBlock Text="Claims" FontWeight="SemiBold" FontSize="16" />
      <ListView ItemsSource="{x:Bind ViewModel.Claims, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedClaim, Mode=TwoWay}">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:WarrantyClaimDto">
            <StackPanel Padding="4,8">
              <TextBlock FontWeight="SemiBold">
                <Run Text="{x:Bind Number}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
              </TextBlock>
              <TextBlock FontSize="12" Opacity="0.75" Text="{x:Bind Summary}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
    <Border Grid.Column="2" Padding="16" CornerRadius="8"
            Background="{ThemeResource WorkshopSurfaceBrush}"
            BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="8">
        <TextBlock Text="Open claim" FontWeight="SemiBold" />
        <TextBox Header="Summary" Text="{x:Bind ViewModel.Summary, Mode=TwoWay}"
                 AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
        <Button Content="Create claim" Command="{x:Bind ViewModel.CreateClaimCommand}"
                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
        <TextBlock Text="Update selected claim" FontWeight="SemiBold" Margin="0,12,0,0" />
        <ComboBox Header="Status" ItemsSource="{x:Bind ViewModel.ClaimStatuses, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.ClaimStatus, Mode=TwoWay}" HorizontalAlignment="Stretch" />
        <Button Content="Apply status" Command="{x:Bind ViewModel.UpdateClaimCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>
    </Border>
  </Grid>
</Page>
