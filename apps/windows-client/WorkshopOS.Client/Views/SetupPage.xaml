<Page
    x:Class="WorkshopOS.Client.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource WorkshopPageBackgroundBrush}">
  <Grid Background="{ThemeResource WorkshopPageBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Padding="32,20,32,0" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
        <TextBlock Text="First-run setup" FontSize="24" FontWeight="SemiBold"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <TextBlock Text="Configure this shop before staff sign in. Integrations can wait."
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
        <Button x:Name="ThemeLightBtn" Content="Light" Click="ThemeLight_Click" Padding="10,4" MinWidth="56" />
        <Button x:Name="ThemeDarkBtn" Content="Dark" Click="ThemeDark_Click" Padding="10,4" MinWidth="56"
                Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" Background="{ThemeResource WorkshopPageBackgroundBrush}">
      <StackPanel MaxWidth="640" Padding="32" Spacing="12"
                  Background="{ThemeResource WorkshopPageBackgroundBrush}">
        <TextBox Header="Business name" Text="{x:Bind ViewModel.BusinessName, Mode=TwoWay}" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition /><ColumnDefinition />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Header="Phone" Text="{x:Bind ViewModel.Phone, Mode=TwoWay}" />
          <TextBox Grid.Column="1" Header="Email" Text="{x:Bind ViewModel.Email, Mode=TwoWay}" />
        </Grid>
        <TextBox Header="ABN" Text="{x:Bind ViewModel.Abn, Mode=TwoWay}" />
        <TextBox Header="Address" Text="{x:Bind ViewModel.Address, Mode=TwoWay}" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>
          <TextBox Header="Suburb" Text="{x:Bind ViewModel.Suburb, Mode=TwoWay}" />
          <TextBox Grid.Column="1" Header="State" Text="{x:Bind ViewModel.State, Mode=TwoWay}" />
          <TextBox Grid.Column="2" Header="Postcode" Text="{x:Bind ViewModel.Postcode, Mode=TwoWay}" />
        </Grid>
        <CheckBox Content="GST registered (default 10%)" IsChecked="{x:Bind ViewModel.GstRegistered, Mode=TwoWay}"
                  Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <TextBlock Text="Owner account" FontWeight="SemiBold" Margin="0,12,0,0"
                   Foreground="{ThemeResource WorkshopTextPrimaryBrush}" />
        <TextBox Header="Full name" Text="{x:Bind ViewModel.OwnerName, Mode=TwoWay}" />
        <TextBox Header="Email" Text="{x:Bind ViewModel.OwnerEmail, Mode=TwoWay}" />
        <PasswordBox Header="Password" PasswordChanged="OwnerPassword_PasswordChanged" />
        <TextBlock Text="At least 10 characters with upper, lower and a number."
                   Foreground="{ThemeResource WorkshopTextSecondaryBrush}" FontSize="12" />
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                   Foreground="{ThemeResource WorkshopDangerBrush}" TextWrapping="Wrap" />
        <Button Content="Complete setup" Command="{x:Bind ViewModel.CompleteCommand}" Style="{StaticResource AccentButtonStyle}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
