<Page
    x:Class="WorkshopOS.Client.Views.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel MaxWidth="640" Padding="32" Spacing="12">
      <TextBlock Text="First-run setup" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Configure this shop before staff sign in. Integrations can wait." Opacity="0.75" TextWrapping="Wrap" />
      <TextBox Header="Business name" Text="{x:Bind ViewModel.BusinessName, Mode=TwoWay}" />
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition /><ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBox Grid.Column="0" Header="Phone" Text="{x:Bind ViewModel.Phone, Mode=TwoWay}" />
        <TextBox Grid.Column="1" Header="Email" Text="{x:Bind ViewModel.Email, Mode=TwoWay}" />
      </Grid>
      <TextBox Header="ABN" Text="{x:Bind ViewModel.Abn, Mode=TwoWay}" />
      <TextBox Header="Address" Text="{x:Bind ViewModel.Address, Mode=TwoWay}" />
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition /><ColumnDefinition Width="100" /><ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>
        <TextBox Header="Suburb" Text="{x:Bind ViewModel.Suburb, Mode=TwoWay}" />
        <TextBox Grid.Column="1" Header="State" Text="{x:Bind ViewModel.State, Mode=TwoWay}" />
        <TextBox Grid.Column="2" Header="Postcode" Text="{x:Bind ViewModel.Postcode, Mode=TwoWay}" />
      </Grid>
      <CheckBox Content="GST registered (default 10%)" IsChecked="{x:Bind ViewModel.GstRegistered, Mode=TwoWay}" />
      <TextBlock Text="Owner account" FontWeight="SemiBold" Margin="0,12,0,0" />
      <TextBox Header="Full name" Text="{x:Bind ViewModel.OwnerName, Mode=TwoWay}" />
      <TextBox Header="Email" Text="{x:Bind ViewModel.OwnerEmail, Mode=TwoWay}" />
      <PasswordBox Header="Password" PasswordChanged="OwnerPassword_PasswordChanged" />
      <TextBlock Text="At least 10 characters with upper, lower and a number." Opacity="0.65" FontSize="12" />
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="DarkRed" TextWrapping="Wrap" />
      <Button Content="Complete setup" Command="{x:Bind ViewModel.CompleteCommand}" Style="{StaticResource AccentButtonStyle}" />
    </StackPanel>
  </ScrollViewer>
</Page>
