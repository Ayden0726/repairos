<Page x:Class="WorkshopOS.Client.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ops="using:WorkshopOS.Contracts.Operations"
      xmlns:local="using:WorkshopOS.Client.Views">
  <ScrollViewer Padding="20">
    <StackPanel Spacing="16">
      <Grid>
        <TextBlock Text="Dashboard" FontSize="22" FontWeight="SemiBold" />
        <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" HorizontalAlignment="Right" />
      </Grid>
      <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="DarkRed" />
      <GridView ItemsSource="{x:Bind ViewModel.Cards, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="Card_Click">
        <GridView.ItemTemplate>
          <DataTemplate x:DataType="local:DashboardCardVm">
            <Border Width="160" Height="72" Padding="12" Margin="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
              <StackPanel>
                <TextBlock Text="{x:Bind Title}" FontSize="12" Opacity="0.7" />
                <TextBlock Text="{x:Bind Value}" FontSize="20" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
      <TextBlock Text="Repair pipeline" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{x:Bind ViewModel.Pipeline, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="ops:PipelineStageDto">
            <Border Padding="8,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
              <TextBlock>
                <Run Text="{x:Bind Name}" /><Run Text=" " /><Run Text="{x:Bind Count}" FontWeight="Bold" />
              </TextBlock>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Urgent / overdue" FontWeight="SemiBold" />
      <ListView ItemsSource="{x:Bind ViewModel.Urgent, Mode=OneWay}" MaxHeight="200">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:UrgentJobDto">
            <TextBlock Text="{x:Bind TicketNumber}" />
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock>
        <Run Text="Unassigned jobs: " /><Run Text="{x:Bind ViewModel.Unassigned, Mode=OneWay}" FontWeight="Bold" />
      </TextBlock>
      <TextBlock Text="Technician workload" FontWeight="SemiBold" />
      <ListView ItemsSource="{x:Bind ViewModel.Workload, Mode=OneWay}" MaxHeight="160">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:TechnicianWorkloadDto">
            <TextBlock>
              <Run Text="{x:Bind Name}" /><Run Text=" — open " /><Run Text="{x:Bind OpenJobs}" />
            </TextBlock>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock Text="Low stock" FontWeight="SemiBold" />
      <ListView ItemsSource="{x:Bind ViewModel.LowStock, Mode=OneWay}" MaxHeight="120">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:LowStockDto">
            <TextBlock Text="{x:Bind Name}" />
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock Text="Recent activity" FontWeight="SemiBold" />
      <ListView ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}" MaxHeight="160">
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="ops:ActivityDto">
            <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
  </ScrollViewer>
</Page>
