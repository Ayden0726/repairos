<Page
    x:Class="WorkshopOS.Client.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:auth="using:WorkshopOS.Contracts.Auth"
    xmlns:vm="using:WorkshopOS.Client.ViewModels">
  <Grid Padding="24" RowSpacing="12" Background="{ThemeResource WorkshopPageBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Appearance, pricing, tax, staff, backups, and server connection." Opacity="0.7" />
    </StackPanel>
    <Pivot x:Name="SettingsPivot" Grid.Row="1" SelectionChanged="SettingsPivot_SelectionChanged">
      <PivotItem Header="App">
        <ScrollViewer Padding="0,16,0,0">
          <StackPanel Spacing="16" MaxWidth="520">
            <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Choose how WorkshopOS looks on this PC. Saved in client-settings.json." Opacity="0.7" TextWrapping="Wrap" />
            <ComboBox x:Name="ThemeCombo" Header="Theme" Width="220" SelectionChanged="ThemeCombo_SelectionChanged">
              <ComboBoxItem Content="Dark" Tag="Dark" />
              <ComboBoxItem Content="Light" Tag="Light" />
              <ComboBoxItem Content="System" Tag="System" />
            </ComboBox>
            <TextBlock x:Name="ThemeStatusText" FontSize="12" Opacity="0.65" />
            <TextBlock Text="Client 1.2.21" FontSize="12" Opacity="0.55" Margin="0,12,0,0" />

            <TextBlock Text="Your password" FontWeight="SemiBold" FontSize="16" Margin="0,16,0,0" />
            <TextBlock Text="Change the password for the account you are signed in as. Requires your current password."
                       Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="ChangePasswordStatusText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="ChangePasswordErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
            <Button Content="Change password…" Click="ChangeOwnPassword_Click" />
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Pricing" Tag="pricing">
        <ScrollViewer Padding="0,16,0,0">
          <StackPanel Spacing="12" MaxWidth="640">
            <TextBlock Text="Automatic pricing" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Labour, parts markup, profitability, rounding, discounts, and quote defaults. Seed defaults are $50 labour / 20% markup — change them here." Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="PricingStatusText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="PricingErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
            <NumberBox x:Name="DefaultLabourBox" Header="Default labour fee" SpinButtonPlacementMode="Compact" />
            <NumberBox x:Name="MinLabourBox" Header="Minimum labour fee" SpinButtonPlacementMode="Compact" />
            <CheckBox x:Name="DifficultyPricingCheck" Content="Enable difficulty labour levels" />
            <ComboBox x:Name="MarkupMethodCombo" Header="Parts markup method" Width="280">
              <x:String>FlatPercent</x:String>
              <x:String>Tiered</x:String>
              <x:String>Fixed</x:String>
              <x:String>Hybrid</x:String>
            </ComboBox>
            <NumberBox x:Name="DefaultMarkupBox" Header="Default markup %" SpinButtonPlacementMode="Compact" />
            <NumberBox x:Name="FixedMarkupBox" Header="Fixed markup amount" SpinButtonPlacementMode="Compact" />
            <NumberBox x:Name="MinPartProfitBox" Header="Minimum part profit" SpinButtonPlacementMode="Compact" />
            <NumberBox x:Name="MinMarginBox" Header="Minimum gross margin %" SpinButtonPlacementMode="Compact" />
            <NumberBox x:Name="WarnMarginBox" Header="Warn below margin %" SpinButtonPlacementMode="Compact" />
            <CheckBox x:Name="ApprovalRequiredCheck" Content="Manager approval required below minimum margin" />
            <ComboBox x:Name="RoundingCombo" Header="Rounding" Width="280">
              <x:String>None</x:String>
              <x:String>Nearest1</x:String>
              <x:String>Nearest5</x:String>
              <x:String>Nearest10</x:String>
              <x:String>End9</x:String>
              <x:String>End995</x:String>
              <x:String>Custom</x:String>
            </ComboBox>
            <NumberBox x:Name="MaxTechDiscountBox" Header="Max tech discount %" SpinButtonPlacementMode="Compact" />
            <NumberBox x:Name="ValidityDaysBox" Header="Default quote validity (days)" SpinButtonPlacementMode="Compact" />
            <CheckBox x:Name="AutoExpireCheck" Content="Auto-expire quotes past validity" />
            <Button Content="Save pricing settings" Click="SavePricing_Click" Style="{StaticResource AccentButtonStyle}" />
            <TextBlock Text="Markup tiers (Option B)" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="TiersList" MinHeight="80" />
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <NumberBox x:Name="TierMinBox" Header="Min cost" />
              <NumberBox Grid.Column="1" x:Name="TierMaxBox" Header="Max cost" />
              <NumberBox Grid.Column="2" x:Name="TierPctBox" Header="Markup %" />
              <Button Grid.Column="3" Content="Add tier" VerticalAlignment="Bottom" Click="AddTier_Click" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Services" Tag="services">
        <ScrollViewer Padding="0,16,0,0">
          <StackPanel Spacing="12" MaxWidth="720">
            <TextBlock Text="Service catalogue admin" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Categories, labour, time, warranty, bundles. Prices are editable seeds — not hard-coded."
                       Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="ServicesStatusText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="ServicesErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Refresh" Click="ServicesRefresh_Click" />
              <Button Content="Re-import seed catalogue" Click="ServicesImport_Click" />
            </StackPanel>
            <TextBlock Text="Categories" FontWeight="SemiBold" />
            <ListView x:Name="CatalogueCategoriesList" MinHeight="80" MaxHeight="160" />
            <TextBlock Text="Services" FontWeight="SemiBold" />
            <TextBox x:Name="CatalogueSearchBox" Header="Filter" PlaceholderText="Search name or code"
                     TextChanged="CatalogueSearch_TextChanged" />
            <ListView x:Name="CatalogueServicesList" MinHeight="160" MaxHeight="280"
                      DisplayMemberPath="Label"
                      SelectionChanged="CatalogueServicesList_SelectionChanged" />
            <TextBlock Text="Edit / add service" FontWeight="SemiBold" />
            <Grid ColumnSpacing="8" RowSpacing="8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBox x:Name="ServiceNameBox" Header="Name" />
              <TextBox x:Name="ServiceCodeBox" Grid.Column="1" Header="Code / SKU" />
              <TextBox x:Name="ServiceCategoryBox" Grid.Row="1" Header="Category" />
              <TextBox x:Name="ServiceSubcategoryBox" Grid.Row="1" Grid.Column="1" Header="Subcategory" />
              <NumberBox x:Name="ServiceLabourBox" Grid.Row="2" Header="Default labour fee" />
              <NumberBox x:Name="ServiceFeeBox" Grid.Row="2" Grid.Column="1" Header="Service fee" />
              <NumberBox x:Name="ServiceMinutesBox" Grid.Row="3" Header="Estimated minutes" />
              <NumberBox x:Name="ServiceWarrantyBox" Grid.Row="3" Grid.Column="1" Header="Warranty days" />
            </Grid>
            <TextBox x:Name="ServiceCustomerDescBox" Header="Customer description" />
            <TextBox x:Name="ServiceTechNotesBox" Header="Technician notes" />
            <NumberBox x:Name="ServiceMarkupBox" Header="Default part markup %" />
            <CheckBox x:Name="ServiceActiveCheck" Content="Active" IsChecked="True" />
            <CheckBox x:Name="ServicePartsRequiredCheck" Content="Parts required" />
            <CheckBox x:Name="ServiceSerialRequiredCheck" Content="Serial / IMEI required" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Save service" Click="SaveService_Click" Style="{StaticResource AccentButtonStyle}" />
              <Button Content="Disable / delete" Click="DeleteService_Click" />
              <Button Content="New (clear form)" Click="ClearServiceForm_Click" />
            </StackPanel>
            <TextBlock Text="Bundles" FontWeight="SemiBold" Margin="0,12,0,0" />
            <ListView x:Name="CatalogueBundlesList" MinHeight="80" MaxHeight="160" />
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Tax" Tag="tax">
        <ScrollViewer Padding="0,16,0,0">
          <StackPanel Spacing="12" MaxWidth="520">
            <TextBlock Text="Business tax (GST)" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Rate and inclusive/exclusive pricing. Not hardcoded to AUD — uses the business profile currency." Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="TaxStatusText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="TaxErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
            <CheckBox x:Name="TaxEnabledCheck" Content="Tax registered / enabled" />
            <NumberBox x:Name="TaxRateBox" Header="Tax rate (e.g. 0.10 for 10%)" SmallChange="0.01" LargeChange="0.05" />
            <CheckBox x:Name="TaxInclusiveCheck" Content="Prices are tax-inclusive" />
            <TextBox x:Name="CurrencyBox" Header="Currency code" />
            <Button Content="Save tax settings" Click="SaveTax_Click" Style="{StaticResource AccentButtonStyle}" />
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Users &amp; Roles" Tag="users">
        <ScrollViewer Padding="0,16,0,0">
          <StackPanel Spacing="20">
            <Grid ColumnSpacing="20">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="8">
                <Grid>
                  <TextBlock Text="Staff accounts" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                  <Button Content="Refresh" Click="UsersRefresh_Click" HorizontalAlignment="Right" />
                </Grid>
                <ProgressRing x:Name="UsersLoadingRing" Width="28" Height="28" HorizontalAlignment="Left" />
                <TextBlock x:Name="UsersStatusText" Opacity="0.7" TextWrapping="Wrap" />
                <TextBlock x:Name="UsersErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
                <ListView x:Name="UsersList"
                          SelectionChanged="UsersList_SelectionChanged"
                          MinHeight="180" MaxHeight="320">
                  <ListView.ItemTemplate>
                    <DataTemplate x:DataType="auth:StaffUserDto">
                      <StackPanel Padding="4,6" Spacing="2">
                        <TextBlock FontWeight="SemiBold">
                          <Run Text="{x:Bind DisplayName}" /><Run Text=" · " /><Run Text="{x:Bind RoleName}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Opacity="0.7">
                          <Run Text="{x:Bind Email}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
                        </TextBlock>
                      </StackPanel>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EditUserPanel" Spacing="8" Visibility="Collapsed">
                  <TextBlock Text="Edit selected" FontWeight="SemiBold" />
                  <ComboBox x:Name="EditRoleCombo" Header="Role" DisplayMemberPath="DisplayLabel" Width="240" />
                  <ComboBox x:Name="EditStatusCombo" Header="Status" Width="240">
                    <x:String>Active</x:String>
                    <x:String>Suspended</x:String>
                  </ComboBox>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Save changes" Click="SaveUser_Click" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="Reset password…" Click="ResetUserPassword_Click" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <Border Grid.Column="1" Padding="16" CornerRadius="8"
                      Background="{ThemeResource WorkshopSurfaceBrush}"
                      BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                  <TextBlock Text="New account" FontWeight="SemiBold" FontSize="16" />
                  <TextBox x:Name="NewDisplayNameBox" Header="Display name" />
                  <TextBox x:Name="NewEmailBox" Header="Email" />
                  <PasswordBox x:Name="NewPasswordBox" Header="Password (min 10, upper/lower/digit)" />
                  <TextBox x:Name="NewPhoneBox" Header="Phone (optional)" />
                  <ComboBox x:Name="NewRoleCombo" Header="Role" DisplayMemberPath="DisplayLabel"
                            HorizontalAlignment="Stretch" PlaceholderText="Select a role" />
                  <TextBlock x:Name="RolesHintText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                  <Button x:Name="CreateUserButton" Content="Create account" Click="CreateUser_Click"
                          Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Padding="16" CornerRadius="8"
                    Background="{ThemeResource WorkshopSurfaceBrush}"
                    BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="8">
                  <Grid>
                    <TextBlock Text="Roles" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                      <Button Content="New role" Click="NewRole_Click" />
                      <Button Content="Save role" Click="SaveRole_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="RolesStatusText" Opacity="0.7" TextWrapping="Wrap" />
                  <TextBlock x:Name="RolesManageErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
                  <ListView x:Name="RolesList"
                            SelectionChanged="RolesList_SelectionChanged"
                            MinHeight="160" MaxHeight="280"
                            DisplayMemberPath="DisplayLabel" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="Role details (Owner/Admin)" FontWeight="SemiBold" />
                  <TextBox x:Name="RoleNameBox" Header="Display name" />
                  <TextBox x:Name="RoleKeyBox" Header="Key (letters/digits/_ ; blank = from name)" />
                  <TextBox x:Name="RoleDescriptionBox" Header="Description" />
                  <TextBlock Text="Permissions" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <ListView x:Name="PermissionsList" MaxHeight="280" SelectionMode="None">
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="vm:PermissionToggleItem">
                        <CheckBox Content="{x:Bind Display}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Backups" Tag="backups">
        <Grid Padding="0,16,0,0" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="Database backups" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="Refresh" Click="BackupsRefresh_Click" />
              <Button Content="Create backup" Click="BackupsCreate_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock x:Name="BackupsStatusText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="BackupsErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
          </StackPanel>
          <ListView x:Name="BackupsList" Grid.Row="2" />
        </Grid>
      </PivotItem>
      <PivotItem Header="Connection">
        <ScrollViewer Padding="0,16,0,0">
          <StackPanel Spacing="12" MaxWidth="640">
            <TextBlock Text="Server &amp; business" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Business profile from the WorkshopOS server." Opacity="0.7" />
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource WorkshopSurfaceBrush}"
                    BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
              <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
            </Border>
            <TextBlock x:Name="ServerUrlText" Opacity="0.75" TextWrapping="Wrap" />
            <Button Content="Change server / pairing code" Click="ChangeServer_Click" />

            <TextBlock Text="API strength / health" FontWeight="SemiBold" FontSize="16" Margin="0,12,0,0" />
            <TextBlock Text="Latency to /api/health, server version, and update/restart controls." Opacity="0.7" TextWrapping="Wrap" />
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource WorkshopSurfaceBrush}"
                    BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="8">
                <TextBlock x:Name="HealthStrengthText" FontWeight="SemiBold" TextWrapping="Wrap" Text="Not checked yet." />
                <ProgressBar x:Name="HealthStrengthBar" Minimum="0" Maximum="100" Value="0" Height="8" />
                <TextBlock x:Name="HealthDetailText" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock x:Name="HealthErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Check health" Click="CheckHealth_Click" Style="{StaticResource AccentButtonStyle}" />
                  <Button Content="Restart server services" Click="RestartServer_Click" />
                </StackPanel>
                <TextBlock Text="Update &amp; restart (WSL / Linux server)" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBox x:Name="RestartCommandsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="120" FontFamily="Consolas" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
