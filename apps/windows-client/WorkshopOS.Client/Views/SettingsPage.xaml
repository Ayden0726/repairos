<Page
    x:Class="WorkshopOS.Client.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Padding="32" Spacing="12" MaxWidth="640">
    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
    <TextBlock Text="Business profile from the WorkshopOS server." Opacity="0.7" />
    <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
      <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</Page>
