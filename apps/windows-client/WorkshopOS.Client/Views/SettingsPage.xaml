<Page
    x:Class="WorkshopOS.Client.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:auth="using:WorkshopOS.Contracts.Auth">
  <Grid Padding="24" RowSpacing="12" Background="{ThemeResource WorkshopPageBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Appearance, staff, backups, and server connection." Opacity="0.7" />
    </StackPanel>
    <Pivot x:Name="SettingsPivot" Grid.Row="1" SelectionChanged="SettingsPivot_SelectionChanged">
      <PivotItem Header="App">
        <ScrollViewer Padding="0,16,0,0">
          <StackPanel Spacing="16" MaxWidth="520">
            <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Choose how WorkshopOS looks on this PC. Saved in client-settings.json." Opacity="0.7" TextWrapping="Wrap" />
            <ComboBox x:Name="ThemeCombo" Header="Theme" Width="220" SelectionChanged="ThemeCombo_SelectionChanged">
              <ComboBoxItem Content="System" Tag="System" />
              <ComboBoxItem Content="Light" Tag="Light" />
              <ComboBoxItem Content="Dark" Tag="Dark" />
            </ComboBox>
            <TextBlock x:Name="ThemeStatusText" FontSize="12" Opacity="0.65" />
            <TextBlock Text="Client 1.2.5" FontSize="12" Opacity="0.55" Margin="0,12,0,0" />
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
      <PivotItem Header="Users &amp; Roles" Tag="users">
        <Grid Padding="0,16,0,0" ColumnSpacing="20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="8">
            <Grid>
              <TextBlock Text="Staff accounts" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
              <Button Content="Refresh" Click="UsersRefresh_Click" HorizontalAlignment="Right" />
            </Grid>
            <ProgressRing x:Name="UsersLoadingRing" Width="28" Height="28" HorizontalAlignment="Left" />
            <TextBlock x:Name="UsersStatusText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="UsersErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
            <ListView x:Name="UsersList"
                      SelectionChanged="UsersList_SelectionChanged"
                      MinHeight="200">
              <ListView.ItemTemplate>
                <DataTemplate x:DataType="auth:StaffUserDto">
                  <StackPanel Padding="4,6" Spacing="2">
                    <TextBlock FontWeight="SemiBold">
                      <Run Text="{x:Bind DisplayName}" /><Run Text=" · " /><Run Text="{x:Bind RoleName}" />
                    </TextBlock>
                    <TextBlock FontSize="12" Opacity="0.7">
                      <Run Text="{x:Bind Email}" /><Run Text=" · " /><Run Text="{x:Bind Status}" />
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EditUserPanel" Spacing="8" Visibility="Collapsed">
              <TextBlock Text="Edit selected" FontWeight="SemiBold" />
              <ComboBox x:Name="EditRoleCombo" Header="Role" DisplayMemberPath="DisplayLabel" Width="240" />
              <ComboBox x:Name="EditStatusCombo" Header="Status" Width="240">
                <x:String>Active</x:String>
                <x:String>Suspended</x:String>
              </ComboBox>
              <Button Content="Save changes" Click="SaveUser_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Padding="16" CornerRadius="8"
                  Background="{ThemeResource WorkshopSurfaceBrush}"
                  BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
              <TextBlock Text="New account" FontWeight="SemiBold" FontSize="16" />
              <TextBox x:Name="NewDisplayNameBox" Header="Display name" />
              <TextBox x:Name="NewEmailBox" Header="Email" />
              <PasswordBox x:Name="NewPasswordBox" Header="Password (min 10, upper/lower/digit)" />
              <TextBox x:Name="NewPhoneBox" Header="Phone (optional)" />
              <ComboBox x:Name="NewRoleCombo" Header="Role" DisplayMemberPath="DisplayLabel"
                        HorizontalAlignment="Stretch" PlaceholderText="Select a role" />
              <TextBlock x:Name="RolesHintText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
              <Button x:Name="CreateUserButton" Content="Create account" Click="CreateUser_Click"
                      Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>
        </Grid>
      </PivotItem>
      <PivotItem Header="Backups" Tag="backups">
        <Grid Padding="0,16,0,0" RowSpacing="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Text="Database backups" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Content="Refresh" Click="BackupsRefresh_Click" />
              <Button Content="Create backup" Click="BackupsCreate_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock x:Name="BackupsStatusText" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock x:Name="BackupsErrorText" Foreground="DarkRed" TextWrapping="Wrap" />
          </StackPanel>
          <ListView x:Name="BackupsList" Grid.Row="2" />
        </Grid>
      </PivotItem>
      <PivotItem Header="Connection">
        <ScrollViewer Padding="0,16,0,0">
          <StackPanel Spacing="12" MaxWidth="560">
            <TextBlock Text="Server &amp; business" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Business profile from the WorkshopOS server." Opacity="0.7" />
            <Border Padding="16" CornerRadius="8" Background="{ThemeResource WorkshopSurfaceBrush}"
                    BorderBrush="{ThemeResource WorkshopBorderBrush}" BorderThickness="1">
              <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
            </Border>
            <TextBlock x:Name="ServerUrlText" Opacity="0.75" TextWrapping="Wrap" />
            <Button Content="Change server / pairing code" Click="ChangeServer_Click" />
          </StackPanel>
        </ScrollViewer>
      </PivotItem>
    </Pivot>
  </Grid>
</Page>
