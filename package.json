    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 47821",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/worker/index.ts",
    "backup": "tsx scripts/backup.ts"
  },
